# AI Pets for Kids — produksiya konfiqurasiyası (environment variable-lar)
#
# Lokal development üçün bu fayl LAZIM DEYİL: src/PetPal.Api/appsettings.json
# içindəki development dəyərləri kifayətdir.
#
# Bu faylı .env adı ilə kopyalayın (.env .gitignore-dadır) və deploy mühitində
# environment variable kimi verin. ASP.NET Core iç-içə açarları "__" ilə oxuyur.

# --- Verilənlər bazası ---
# Konteyner şəbəkəsi daxilində port 5432-dir (host-da 5433-ə map olunur — bax docker-compose.yml).
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=petpal;Username=petpal;Password=DEYIS-MENI

# --- JWT (MÜTLƏQ override olunmalıdır) ---
# Ən azı 32 simvol. Nümunə generasiya:
#   pwsh -c "[Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))"
Jwt__Key=BURAYA-EN-AZI-32-SIMVOLLUQ-TESADUFI-ACAR
Jwt__Issuer=petpal-api
Jwt__Audience=petpal-app
Jwt__AccessTokenMinutes=60
Jwt__RefreshTokenDays=30

# --- Miqrasiya ---
# Ayrıca migrate job-u işlədirsinizsə false qoyun (`dotnet PetPal.Api.dll --migrate-only`).
Database__MigrateOnStartup=true

# --- CORS ---
# Boş buraxılsa bütün origin-lərə icazə verilir — produksiyada mütləq doldurun.
Cors__AllowedOrigins__0=https://app.petpal.example

# --- Rate limiting ---
RateLimiting__Auth__PermitLimit=20
RateLimiting__Auth__WindowSeconds=60
RateLimiting__Social__PermitLimit=60
RateLimiting__Social__WindowSeconds=60

# --- Kəşf (Real Life Connect) ---
Discovery__MaxRewardedPerDay=5
Discovery__MaxPhotoBytes=31457280

# Şəkillərin saxlanması. DİQQƏT: konteynerin öz diski MÜVƏQQƏTİDİR — heç biri
# qoşulmasa, uşağın çəkdiyi şəkillər hər deploy-da itir (qeyd bazada qalır).
#
# Yol A — kalıcı volume: mount edilmiş qovluğun yolunu yazın.
# Discovery__StorageRoot=/data
#
# Yol B — S3-uyğun obyekt saxlama (AWS S3, Cloudflare R2, Backblaze B2, MinIO).
# Bucket doldurulan kimi bu yol seçilir və StorageRoot oxunmur.
# Discovery__S3__Bucket=petpal-discoveries
# Discovery__S3__ServiceUrl=https://<account>.r2.cloudflarestorage.com
# Discovery__S3__Region=auto
# Discovery__S3__AccessKey=...
# Discovery__S3__SecretKey=...
# R2 və MinIO üçün ikisi də true qalmalıdır.
# Discovery__S3__ForcePathStyle=true
# Discovery__S3__DisablePayloadSigning=true

# --- Push bildirişləri (könüllü) ---
# Söndürülüb qalsa app tam işləyir, sadəcə bildiriş göndərmir.
# Firebase Console → Project settings → Service accounts → yeni açar (JSON).
# JSON-un BÜTÖV məzmunu bir sətirdə verilir.
# Notifications__Enabled=true
# Notifications__ProjectId=petpal-12345
# Notifications__ServiceAccountJson={"type":"service_account", ...}
#
# Uşağa gedən bildirişlər yuxu rejimində saxlanılır. Yalnız sınaq üçün söndürün.
# Notifications__RespectBedtime=true

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# --- Pet Brain (Adaptive Pet Director) ---
# Özəllik standart olaraq AÇIQDIR; qalan üç açar qoruyucu şəkildə bağlıdır.
# DemoMode münsif/izah panelini uşaq interfeysində göstərir — PRODUKSİYADA BAĞLI QALSIN.
PetBrain__Enabled=true
PetBrain__DemoMode=false
# Nümayiş profilləri (Aylin + Mia). Yalnız Development-də işləyir; produksiyada
# əlavə olaraq PetBrain__AllowSeedOutsideDevelopment=true tələb olunur.
PetBrain__SeedDemoData=false
# Başlıq/giriş mətnini modelə yazdırır. Bağlı olanda heç bir model çağırışı olmur.
PetBrain__UseAiNarrative=false

# --- Pet Brain media: tapmaca rəsmi + 10 saniyəlik recap videosu (könüllü) ---
# Standart PROVAYDERSİZDİR: heç bir xarici çağırış getmir və xərc sıfırdır.
# Aşağıdakıları açanda bir yeni tamamlanmış run təxminən $0.55 tutur
# (gen4_image 5 kredit + gen4_turbo 10 saniyə × 5 kredit; 1 kredit = $0.01).
# Keşlənmiş təkrar və ehtiyat variant $0-dır — bax docs/PET_BRAIN.md.
# PetBrainMedia__Provider=Runway
# PetBrainMedia__Profile=Budget
#
# Gündəlik say həddi standart olaraq YOXDUR (0). Qaytarmaq üçün müsbət dəyər yazın:
# PetBrainMedia__MaxPaidScenesPerDay=0
# PetBrainMedia__MaxPaidRecapsPerChildPerDay=0
# PetBrainMedia__MaxPaidRecapsPerDay=0
# Wardrobe__DesignsPerChildPerDay=0
# Wardrobe__MaxPaidImagesPerDay=0
#
# Açar YALNIZ buradan və ya secret store-dan verilir; heç vaxt commit edilmir.
# Runway__ApiKey=key_...
