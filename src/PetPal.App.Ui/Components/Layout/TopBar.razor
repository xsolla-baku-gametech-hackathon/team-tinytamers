@implements IDisposable
@inject AppSession Session
@inject AppState State
@inject Loc Loc
@inject NavigationManager Navigation

@* Üst panel maketdəki HUD-dur: solda səviyyə halqası + ad, sağda cüzdan.
   Ev ekranında bu panel səhnənin üstündə üzür (app-shell--immersive), digər
   ekranlarda isə adi zolaq kimi oturur.

   Panel və menyu bir sarğı içindədir: Ev ekranında mövqe həmin sarğıya verilir,
   ona görə menyu həmişə panelin ALTINDA açılır. Əvvəl yalnız <header> mütləq
   mövqe alırdı və menyu axında qalıb panelin altına girirdi. *@
<div class="topbar-shell">
<header class="topbar">
    <div class="hud__level">
        <div class="hud__ring" aria-hidden="true">
            <svg viewBox="0 0 44 44" width="42" height="42">
                <circle cx="22" cy="22" r="18" fill="none" stroke="var(--pp-track)" stroke-width="6" />
                <circle cx="22" cy="22" r="18" fill="none" stroke="var(--pp-primary)" stroke-width="6"
                        stroke-linecap="round" stroke-dasharray="113"
                        stroke-dashoffset="@XpDashOffset" transform="rotate(-90 22 22)" />
                <circle cx="22" cy="22" r="14" fill="var(--pp-primary)" />
            </svg>
            <div class="hud__ring-value">@PetAge</div>
        </div>
        <div class="hud__name">
            <div class="hud__name-text">@Session.ActiveChildName</div>
            <div class="hud__name-sub">@XpLabel</div>
        </div>
    </div>

    <div class="topbar__actions">
        @* Ulduz və gem inline SVG-dir: emoji platformadan asılı olaraq başqa
           formada və başqa rəngdə çəkilir, burada isə hər ikisi öz rəng
           ailəsinin tokenlərini daşımalıdır. *@
        <span class="currency currency--star">
            <span class="currency__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18">
                    <path d="M12 3.2l2.6 5.6 6.1.8-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6L3.3 9.6l6.1-.8z"
                          fill="var(--pp-spark)" stroke="var(--pp-spark-edge)" stroke-width="1.6"
                          stroke-linejoin="round" />
                </svg>
            </span>@State.Wallet.Stars
        </span>
        <span class="currency currency--gem">
            <span class="currency__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18">
                    <path d="M7.5 4h9l4 5-8.5 11L3.5 9z" fill="var(--pp-primary-lift)"
                          stroke="var(--pp-primary-edge)" stroke-width="1.6" stroke-linejoin="round" />
                    <path d="M7.5 4l4.5 5 4.5-5M3.5 9h17" fill="none"
                          stroke="var(--pp-primary-edge)" stroke-width="1.4" />
                </svg>
            </span>@State.Wallet.Gems
        </span>
        <button class="btn btn--quiet" @onclick="OpenMenu" aria-label="@(Loc.T("Menyu", "Menu"))">☰</button>
    </div>
</header>

@if (_menuOpen)
{
    <div class="card topbar__menu">
        <button class="btn btn--ghost btn--block" @onclick='() => Go("/progress")'>@Loc.T("Mənim inkişafım", "My progress")</button>
        <div style="height:10px"></div>
        <button class="btn btn--ghost btn--block" @onclick='() => Go("/parent")'>@Loc.T("Valideyn bölməsi", "Parent area")</button>
        <div style="height:10px"></div>
        <button class="btn btn--quiet btn--block" @onclick="SwitchProfile">@Loc.T("Profili dəyiş", "Switch profile")</button>
    </div>
}
</div>

@code {
    private bool _menuOpen;

    protected override void OnInitialized()
    {
        Session.Changed += OnChanged;
        State.Changed += OnChanged;
    }

    /* Səviyyə və XP AppState-dən gəlir: hər ekranda eyni dəyəri göstərsin deyə
       panel öz sorğusunu atmır, mövcud vəziyyəti oxuyur. Pet hələ yüklənməyibsə
       halqa boş qalır və rəqəm 1-dir — panel heç vaxt boş görünmür. */
    /// <summary>Halqadakı rəqəm pet-in YAŞIdır — səviyyə ilə eynidir.</summary>
    private int PetAge => State.Pet?.Level ?? 1;

    private int XpPercent
    {
        get
        {
            var pet = State.Pet;
            if (pet is null || pet.XpToNextLevel == 0)
                return 0;

            return Math.Clamp(pet.Xp * 100 / pet.XpToNextLevel, 0, 100);
        }
    }

    /// <summary>Halqanın doluluğu — çevrənin uzunluğu 113 (r = 18).</summary>
    private string XpDashOffset =>
        (113 - 113 * XpPercent / 100.0)
            .ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>
    /// Alt sətir növbəti YAŞA nə qədər qaldığını deyir. "Səviyyə" sözü
    /// uşaq üçün mücərrəddir, ad günü isə tanış hadisədir.
    /// </summary>
    private string XpLabel =>
        State.Pet is null
            ? Loc.T("1 yaş", "Age 1")
            : Loc.T($"{State.Pet.Xp} / {State.Pet.XpToNextLevel} XP → {State.Pet.Level + 1} yaş",
                    $"{State.Pet.Xp} / {State.Pet.XpToNextLevel} XP → age {State.Pet.Level + 1}");

    private void OpenMenu() => _menuOpen = !_menuOpen;

    private void Go(string url)
    {
        _menuOpen = false;
        Navigation.NavigateTo(url);
    }

    private void SwitchProfile()
    {
        _menuOpen = false;
        Session.ExitChild();
        Navigation.NavigateTo("/profiles", replace: true);
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Session.Changed -= OnChanged;
        State.Changed -= OnChanged;
    }
}
