@inject Loc Loc

@* Tapmaca lövhəsi — QAPALI mexanika açarını tanınan komponentə bağlayır.

   Server HEÇ VAXT hazır HTML göndərmir: yalnız mexanika açarı, lövhə məlumatı
   və cavab sxemi gəlir, çəkmək isə tamamilə burada baş verir. Naməlum açar
   BAĞLI sınır (fail closed) — heç nə render olunmur.

   Seçim vəziyyəti bir yerdədir, çünki dörd mexanikanın hamısı eyni işi görür:
   sıralı id siyahısı yığır. Fərq TƏQDİMATDADIR — biri xəritədə marşrut çəkir,
   digəri kartları sıralayır. *@

<div class="pbx-puzzle pbx-puzzle--@MechanicClass">

    @if (!string.IsNullOrWhiteSpace(Puzzle.StoryPrompt))
    {
        @* Hekayə cümləsi göstərişdən ƏVVƏL gəlir: uşaq əvvəlcə NİYƏ, sonra
           NƏ etdiyini bilməlidir. *@
        <p class="pbx-puzzle__story">@Puzzle.StoryPrompt</p>
    }

    @if (!string.IsNullOrWhiteSpace(JournalNote))
    {
        <div class="pbx-puzzle__journal" aria-live="polite">
            <span class="pbx-puzzle__journal-tag">
                <span aria-hidden="true">📓</span>
                @Loc.T("Jurnalında yazılıb", "From your journal")
                @if (!string.IsNullOrWhiteSpace(JournalNoteTitle))
                {
                    <strong>@JournalNoteTitle</strong>
                }
            </span>
            <span class="pbx-puzzle__journal-text">@JournalNote</span>
        </div>
    }

    @switch (Puzzle.Mechanic)
    {
        case PetBrainPuzzleMechanic.OrderedRoute:
            <OrderedRoutePuzzle Puzzle="Puzzle" Route="_selected" Busy="Busy"
                                SceneImage="@SceneImage" SceneAwakening="@SceneAwakening"
                                OnChanged="StateHasChanged" />
            break;

        case PetBrainPuzzleMechanic.SequenceOrder:
            <SequenceOrderPuzzle Puzzle="Puzzle" Selected="_selected" Busy="Busy" OnToggle="Toggle" />
            break;

        case PetBrainPuzzleMechanic.RouteLogic:
            <RouteLogicPuzzle Puzzle="Puzzle" Selected="_selected" Busy="Busy" OnToggle="Toggle" />
            break;

        case PetBrainPuzzleMechanic.LightFragments:
            <LightFragmentsPuzzle Puzzle="Puzzle" Selected="_selected" Busy="Busy"
                                  SceneImage="@SceneImage" SceneAwakening="@SceneAwakening"
                                  OnToggle="Toggle" />
            break;

        case PetBrainPuzzleMechanic.SignalPattern:
            <SignalPatternPuzzle Puzzle="Puzzle" Selected="_selected" Busy="Busy" OnToggle="Toggle" />
            break;

        case PetBrainPuzzleMechanic.ObservationRecall:
            <ObservationRecallPuzzle Puzzle="Puzzle" Selected="_selected" Busy="Busy" OnToggle="Toggle" />
            break;

        case PetBrainPuzzleMechanic.MatchingPairs:
            <MatchingPairsPuzzle Puzzle="Puzzle" Selected="_selected" Busy="Busy" OnToggle="Toggle" />
            break;

        case PetBrainPuzzleMechanic.PictureAssembly:
            <PictureAssemblyPuzzle Puzzle="Puzzle" Placed="_selected" Busy="Busy"
                                   SceneImage="@SceneImage" SceneAwakening="@SceneAwakening"
                                   SceneKey="@SceneKey" RevealIds="RevealIds"
                                   OnChanged="StateHasChanged" />
            break;
    }

    @* Seçimin vəziyyəti mətnlə də bildirilir — rəng tək daşıyıcı deyil. *@
    <div class="pbx-puzzle__status" aria-live="polite">@StatusText</div>

    <button class="btn btn--primary btn--block pbx-puzzle__send"
            disabled="@(Busy || !IsReady)" @onclick="SubmitAsync">
        @SubmitLabel
    </button>

    @if (Puzzle.HintAvailable)
    {
        @if (!string.IsNullOrWhiteSpace(Puzzle.Hint))
        {
            @* İpucu MARAĞI AZALTMIR və mükafatı kəsmir — sadəcə köməkdir. *@
            <div class="pbx__hint" aria-live="polite">
                <span aria-hidden="true">💡</span> @Puzzle.Hint
            </div>

            @if (RevealedLabels.Count > 0)
            {
                <ul class="pbx-puzzle__revealed" aria-label="@Loc.T("Artıq açılmış addımlar", "Steps already shown")">
                    @foreach (var label in RevealedLabels)
                    {
                        <li class="pbx-puzzle__revealed-step"><span aria-hidden="true">✓</span> @label</li>
                    }
                </ul>
            }

            @if (AssistAvailable)
            {
                <button class="btn btn--ghost btn--block pbx-puzzle__assist" disabled="@Busy" @onclick="OnAssist">
                    🤝 @Loc.T("Gəl birlikdə bitirək", "Let us finish it together")
                </button>
            }
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(HintOffer))
            {
                @* Dəvətin ÜSLUBU pet-in xarakterindəndir: alim yoxlamağa,
                   kəşfiyyatçı xəritəyə baxmağa çağırır. Heç bir variantda
                   kömək istəmək zəiflik kimi verilmir. *@
                <p class="pbx__hint-offer">@HintOffer</p>
            }

            <button class="btn btn--ghost btn--block pbx__hint-btn" disabled="@Busy" @onclick="OnHint">
                💡 @Loc.T("İpucu ver", "Give me a hint")
            </button>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public PetBrainPuzzleDto Puzzle { get; set; } = new();

    /// <summary>Jurnaldan bu tapmacaya aid qeyd — uşağın əvvəl tapdığı ipucu.</summary>
    [Parameter] public string JournalNote { get; set; } = string.Empty;

    [Parameter] public string JournalNoteTitle { get; set; } = string.Empty;

    /// <summary>İpucunun açdığı addımlar — cavabın ən çox yarısı.</summary>
    [Parameter] public IReadOnlyList<string> RevealIds { get; set; } = [];

    /// <summary>Pet «birlikdə bitirək» təklif edir — ipucunun son pilləsi.</summary>
    [Parameter] public bool AssistAvailable { get; set; }

    [Parameter] public EventCallback OnAssist { get; set; }

    /// <summary>
    /// Açılmış addımların GÖRÜNƏN adları.
    ///
    /// <para>Id-lər elementlərdə və ya marşrut düyünlərində axtarılır: iki
    /// lövhə növü eyni ipucu nərdivanını işlədir.</para>
    /// </summary>
    private IReadOnlyList<string> RevealedLabels =>
    [
        .. RevealIds
            .Select(id => Puzzle.Items.FirstOrDefault(i => i.Id == id)?.Label
                          ?? Puzzle.Nodes.FirstOrDefault(n => n.Id == id)?.Label)
            .Where(label => !string.IsNullOrWhiteSpace(label))
            .Select(label => label!)
    ];

    [Parameter] public bool Busy { get; set; }

    /// <summary>Xarakterin səsi ilə ipucu dəvəti; boşdursa göstərilmir.</summary>
    [Parameter] public string? HintOffer { get; set; }

    /// <summary>
    /// Hazır hekayə rəsmi (data URI) — YOXDURSA lövhə deterministik səhnə ilə
    /// çəkilir. Həndəsə hər iki halda EYNİDİR: rəsm yalnız fondur.
    /// </summary>
    [Parameter] public string? SceneImage { get; set; }

    /// <summary>
    /// AI rəsmi yoldadır — öz səhnəsi olan lövhə (marşrut, qanad) sehrli toz
    /// göstərir; qalan mexanikalarda tozu macəra səhnəsi daşıyır.
    /// </summary>
    [Parameter] public bool SceneAwakening { get; set; }

    /// <summary>
    /// Macəranın səhnə açarı — şəkil yığımı rəsm gəlməyəndə bu səhnənin
    /// deterministik şəklini kəsir.
    /// </summary>
    [Parameter] public string SceneKey { get; set; } = string.Empty;

    /// <summary>Cavab serverə YALNIZ id siyahısı kimi gedir.</summary>
    [Parameter] public EventCallback<List<string>> OnSubmit { get; set; }

    [Parameter] public EventCallback OnHint { get; set; }

    /// <summary>Seçilmiş id-lər — SIRA saxlanılır, çünki ardıcıllıq sxemi ondan asılıdır.</summary>
    private readonly List<string> _selected = [];

    /// <summary>Tapmaca dəyişəndə (yeni mərhələ, yeni cəhd) seçim sıfırlanır.</summary>
    private Guid _renderedPuzzleId;

    private bool IsRoute => Puzzle.Mechanic == PetBrainPuzzleMechanic.OrderedRoute;

    private bool IsPicture => Puzzle.Mechanic == PetBrainPuzzleMechanic.PictureAssembly;

    protected override void OnParametersSet()
    {
        if (_renderedPuzzleId == Puzzle.PuzzleId)
            return;

        _renderedPuzzleId = Puzzle.PuzzleId;
        _selected.Clear();

        // Marşrut həmişə başlanğıc düyünündən açılır — dron onsuz da oradadır,
        // uşağı "əvvəlcə eniş moduluna toxun" addımına məcbur etmək mənasızdır.
        if (IsRoute && Puzzle.Nodes.FirstOrDefault(n => n.Kind == PetBrainNodeKind.Start) is { } start)
            _selected.Add(start.Id);
    }

    /// <summary>
    /// Göndərməyə hazırdırmı.
    ///
    /// <para>Marşrutda şərt say deyil, VARIŞDIR: dron bir yerə çatmalıdır.
    /// Yarımçıq yol göndərmək uşağa "səhv etdin" eşitdirərdi — halbuki o,
    /// sadəcə hələ yolda idi.</para>
    /// </summary>
    private bool IsReady => IsRoute
        ? _selected.Count >= Puzzle.AnswerSchema.Min
            && Puzzle.Nodes.Any(n => n.Id == _selected[^1] && n.Kind == PetBrainNodeKind.Goal)
        : _selected.Count >= Puzzle.AnswerSchema.Min;

    private string MechanicClass => Puzzle.Mechanic switch
    {
        PetBrainPuzzleMechanic.OrderedRoute => "route-map",
        PetBrainPuzzleMechanic.SequenceOrder => "sequence",
        PetBrainPuzzleMechanic.RouteLogic => "route",
        PetBrainPuzzleMechanic.PictureAssembly => "picture",
        _ => "fragments"
    };

    /// <summary>
    /// Təzyiqsiz yolda "yoxla" sözü işlədilmir: orada yoxlanılası doğru cavab
    /// yoxdur, uşaq sadəcə qurur.
    /// </summary>
    private string SubmitLabel => Puzzle.LowPressure
        ? Loc.T("Hazırdır!", "Done!")
        : IsRoute
            ? Loc.T("Dronu göndər", "Send the drone")
            : IsPicture
                ? Loc.T("Şəkil hazırdır!", "The picture is ready!")
                : Loc.T("Yoxla", "Check");

    private string StatusText
    {
        get
        {
            if (IsRoute)
            {
                return IsReady
                    ? Loc.T("Marşrut hazırdır", "The route is ready")
                    : Loc.T("Dronu Roboya çatdır", "Guide the drone to Robo");
            }

            if (IsPicture)
            {
                return IsReady
                    ? Loc.T("Şəkil tamamdır — albom üçün göndər!", "The picture is complete — send it to the album!")
                    : Loc.T("Parçaları çərçivəyə yerləşdir", "Place the pieces in the frame");
            }

            var remaining = Puzzle.AnswerSchema.Min - _selected.Count;

            if (remaining > 0)
                return Loc.T($"Daha {remaining} seç", $"Choose {remaining} more");

            return Puzzle.LowPressure
                ? Loc.T("Gözəl seçimdir!", "Lovely choice!")
                : Loc.T("Hazırsan — yoxlaya bilərik", "Ready — we can check it");
        }
    }

    /// <summary>
    /// Elementə toxunuş. Hədd dolubsa ƏN KÖHNƏ seçim çıxarılır — uşaq
    /// "əvvəlcə birini ləğv et" məcburiyyəti ilə üzləşmir.
    /// </summary>
    private void Toggle(string id)
    {
        if (Busy)
            return;

        if (_selected.Remove(id))
            return;

        if (_selected.Count >= Puzzle.AnswerSchema.Max)
            _selected.RemoveAt(0);

        _selected.Add(id);
    }

    private async Task SubmitAsync()
    {
        if (!IsReady || Busy)
            return;

        await OnSubmit.InvokeAsync([.. _selected]);
    }
}
