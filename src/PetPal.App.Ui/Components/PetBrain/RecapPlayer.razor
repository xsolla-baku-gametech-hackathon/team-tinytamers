@inject Loc Loc
@implements IDisposable

<div class="pbx-recap">

    <div class="pbx-recap__stage">
        <div class="pbx-recap__board pbx-recap__board--@SceneKey"
             role="img"
             aria-label="@Loc.T("Macəranın 10 saniyəlik xülasəsi", "The ten-second recap of the adventure")">
            @foreach (var (shot, index) in Recap.Shots.Select((s, i) => (s, i)))
            {
                <span class="pbx-recap__shot @(index == _shot && _playing ? "pbx-recap__shot--on" : null)">
                    @shot.Icon
                </span>
            }
        </div>

        <div class="pbx-recap__bar">
            <button type="button" class="pbx-recap__control" @onclick="Toggle"
                    aria-label="@(_playing ? Loc.T("Dayandır", "Pause") : Loc.T("Oynat", "Play"))">
                <span aria-hidden="true">@(_playing ? "⏸" : "▶")</span>
            </button>

            <button type="button" class="pbx-recap__control" @onclick="Replay"
                    aria-label="@Loc.T("Yenidən oynat", "Play again")">
                <span aria-hidden="true">↻</span>
            </button>
        </div>
    </div>

    <ol class="pbx-recap__captions">
        @foreach (var (shot, index) in Recap.Shots.Select((s, i) => (s, i)))
        {
            <li class="pbx-recap__caption @(index == _shot && _playing ? "pbx-recap__caption--on" : null)">
                <span class="pbx-recap__caption-icon" aria-hidden="true">@shot.Icon</span>
                <span class="pbx-recap__caption-text">@shot.Caption</span>
            </li>
        }
    </ol>

    @if (HasVideo)
    {
        <button type="button" class="btn btn--primary pbx-recap__watch" @onclick="WatchAsync">
            <span aria-hidden="true">🎬</span>
            <span>@Loc.T("Videoya tam ekranda bax", "Watch the video full screen")</span>
        </button>
    }
    else if (Recap.Status is PetBrainRecapStatus.Pending or PetBrainRecapStatus.Generating)
    {
        <p class="pbx-recap__status" role="status">
            <span aria-hidden="true">⏳</span>
            <span>@Loc.T("Video hazırlanır. Hazır olanda «Macəra videoların» bölməsində də qalacaq.",
                         "The video is on its way. When it is ready, it will also stay in “Your adventure videos”.")</span>
        </p>
    }
</div>

@code {
    /// <summary>
    /// Macəranın 10 saniyəlik xülasəsi. Deterministik storyboard HƏMİŞƏ
    /// görünür — uşağın həqiqi seçimləri ilə, heç nə xərcləmədən. Altyazılar
    /// serverdən gəlir və videonun içində deyil.
    /// </summary>
    [Parameter, EditorRequired] public PetBrainRecapDto Recap { get; set; } = new();

    /// <summary>Recap-ın aid olduğu run — video onun ÖZ, sahiblik yoxlanan endpoint-indən açılır.</summary>
    [Parameter] public Guid RunId { get; set; }

    /// <summary>Səhnə açarı — deterministik fonun rəngini seçir.</summary>
    [Parameter] public string SceneKey { get; set; } = "mars";

    /// <summary>
    /// Hərəkət həssaslığı. Açıq olanda storyboard ÖZBAŞINA sürüşmür — bütün
    /// altyazılar onsuz da eyni anda oxunandır, yəni heç nə itmir.
    /// </summary>
    [Parameter] public bool ReducedMotion { get; set; }

    /// <summary>
    /// Hazır videonu açmaq istəyi. Video bu kartın içində OYNAMIR: tam ekran
    /// oynadıcı səhifənin kökündədir (<c>RecapTheater</c>), çünki `absolute`
    /// qat ən yaxın yerləşdirilmiş valideynə yapışır — kartda açılsaydı yalnız
    /// kartı, kökdə isə bütün ekranı tutur.
    /// </summary>
    [Parameter] public EventCallback OnWatch { get; set; }

    private Timer? _timer;
    private bool _playing;
    private int _shot;

    private bool HasVideo =>
        Recap.Status == PetBrainRecapStatus.Ready &&
        !string.IsNullOrEmpty(Recap.VideoUrl) &&
        RunId != Guid.Empty;

    /// <summary>
    /// Kadrın müddəti — storyboard videonun vaxtı ilə EYNİ ritmdə gedir, yəni
    /// uşaq hansı qatı görməsindən asılı olmayaraq eyni hekayəni izləyir.
    /// </summary>
    private TimeSpan ShotLength => TimeSpan.FromSeconds(
        Recap.Shots.Count == 0 ? Recap.DurationSeconds : Recap.DurationSeconds / Recap.Shots.Count);

    private async Task WatchAsync()
    {
        _playing = false;
        Stop();

        await OnWatch.InvokeAsync();
    }

    private void Toggle()
    {
        _playing = !_playing;

        if (_playing)
            Start();
        else
            Stop();
    }

    private void Replay()
    {
        _shot = 0;
        _playing = true;

        Start();
    }

    /// <summary>
    /// Storyboard-u oynadır. Hərəkət həssaslığında kadrlar dəyişmir — vurğu
    /// birinci kadrda qalır. Sonuncu kadrdan sonra DAYANIR: sonsuz dövrə yoxdur.
    /// </summary>
    private void Start()
    {
        Stop();

        if (ReducedMotion || Recap.Shots.Count == 0)
            return;

        _timer = new Timer(_ =>
        {
            if (_shot + 1 >= Recap.Shots.Count)
            {
                _playing = false;
                Stop();
            }
            else
            {
                _shot++;
            }

            InvokeAsync(StateHasChanged);
        }, null, ShotLength, ShotLength);
    }

    private void Stop()
    {
        _timer?.Dispose();
        _timer = null;
    }

    public void Dispose() => Stop();
}
