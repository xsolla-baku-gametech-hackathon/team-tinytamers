    /// <summary>
    /// Formanın yerli vəziyyəti.
    ///
    /// <para>Sorğu müqaviləsi nullable-dır (yalnız göndərilən sahə dəyişir),
    /// amma forma üçün hər sahənin dəyəri olmalıdır. Bu sinif ikisi arasında
    /// dayanır: ekrandan dolur, sorğuya isə tam dəst kimi gedir.</para>
    /// </summary>
    private sealed class SettingsForm
    {
        public bool PersonalizationEnabledValue { get; set; } = true;
        public bool AiNarrativeEnabledValue { get; set; } = true;
        public bool SurpriseEnabledValue { get; set; } = true;

        public PetBrainSessionLength SessionLengthValue { get; set; } = PetBrainSessionLength.Medium;
        public PetBrainPace PaceValue { get; set; } = PetBrainPace.Balanced;
        public PetBrainNoveltyTolerance NoveltyValue { get; set; } = PetBrainNoveltyTolerance.Balanced;
        public PetBrainHintStyle HintStyleValue { get; set; } = PetBrainHintStyle.Visual;
        public PetBrainHintTiming HintTimingValue { get; set; } = PetBrainHintTiming.OnRequest;
        public PetBrainReadingLevel ReadingLevelValue { get; set; } = PetBrainReadingLevel.Standard;
        public PetBrainRewardPreference RewardValue { get; set; } = PetBrainRewardPreference.PetCosmetic;

        public bool ReducedOptionsValue { get; set; }
        public bool DemonstrationFirstValue { get; set; }
        public bool ExtraResponseTimeValue { get; set; }

        public bool ReducedMotionValue { get; set; }
        public bool LargeTextValue { get; set; }
        public bool HighContrastValue { get; set; }
        public bool IconWithTextValue { get; set; }
        public bool NarrationValue { get; set; }
        public bool SubtitlesValue { get; set; } = true;

        public void Load(PetBrainSettingsDto settings)
        {
            PersonalizationEnabledValue = settings.PersonalizationEnabled;
            AiNarrativeEnabledValue = settings.AiNarrativeEnabled;
            SurpriseEnabledValue = settings.SurpriseEnabled;

            SessionLengthValue = settings.SessionLength;
            PaceValue = settings.Pace;
            NoveltyValue = settings.NoveltyTolerance;
            HintStyleValue = settings.HintStyle;
            HintTimingValue = settings.HintTiming;
            ReadingLevelValue = settings.ReadingLevel;
            RewardValue = settings.RewardPreference;

            ReducedOptionsValue = settings.ReducedOptions;
            DemonstrationFirstValue = settings.DemonstrationFirst;
            ExtraResponseTimeValue = settings.ExtraResponseTime;

            ReducedMotionValue = settings.ReducedMotion;
            LargeTextValue = settings.LargeText;
            HighContrastValue = settings.HighContrast;
            IconWithTextValue = settings.IconWithText;
            NarrationValue = settings.Narration;
            SubtitlesValue = settings.Subtitles;
        }

        public UpdateParentPersonalizationRequest ToRequest() => new()
        {
            PersonalizationEnabled = PersonalizationEnabledValue,
            AiNarrativeEnabled = AiNarrativeEnabledValue,
            SurpriseEnabled = SurpriseEnabledValue,
            SessionLength = SessionLengthValue,
            Pace = PaceValue,
            NoveltyTolerance = NoveltyValue,
            HintStyle = HintStyleValue,
            HintTiming = HintTimingValue,
            ReadingLevel = ReadingLevelValue,
            RewardPreference = RewardValue,
            ReducedOptions = ReducedOptionsValue,
            DemonstrationFirst = DemonstrationFirstValue,
            ExtraResponseTime = ExtraResponseTimeValue,
            ReducedMotion = ReducedMotionValue,
            LargeText = LargeTextValue,
            HighContrast = HighContrastValue,
            IconWithText = IconWithTextValue,
            Narration = NarrationValue,
            Subtitles = SubtitlesValue
        };
    }
}
