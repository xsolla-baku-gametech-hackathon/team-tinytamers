@* Qulluq statının halqa ölçəri (0–100).

   Zolaq əvəzinə halqa seçilib: dörd stat yan-yana duranda halqa daha az yer
   tutur və doluluq bir baxışda oxunur. Rəng tək daşıyıcı deyil — rəqəm və
   ikona da var, ona görə rəng korluğunda da işləyir.

   30%-dən aşağı düşən stat ailə rəngindən çıxıb moruğa keçir və kartın kənarı
   işarələnir: uşaq nəyin lazım olduğunu axtarmadan görür. *@

<div class="gauge @(IsLow ? "gauge--alert" : null)" role="img" aria-label="@Label: @Percent%">
    <div class="gauge__ring">
        <svg viewBox="0 0 44 44" width="40" height="40" aria-hidden="true">
            <circle cx="22" cy="22" r="17" fill="none" stroke="@TrackColor" stroke-width="5.5" />
            <circle cx="22" cy="22" r="17" fill="none" stroke="@StrokeColor" stroke-width="5.5"
                    stroke-linecap="round" stroke-dasharray="107" stroke-dashoffset="@DashOffset"
                    transform="rotate(-90 22 22)" />
        </svg>
        <span class="gauge__icon" aria-hidden="true">
            @switch (Icon)
            {
                case "food":
                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M6 3v7a3 3 0 0 0 3 3v8M6 3v5M9 3v5M15 3c-1.5 2-2 4-2 6 0 2 1 3 2.5 3H17v9"
                              stroke="@StrokeColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    break;

                case "heart":
                    <svg viewBox="0 0 24 24">
                        <path d="M12 20s-7-4.4-7-9.2A4 4 0 0 1 12 8a4 4 0 0 1 7 2.8C19 15.6 12 20 12 20z"
                              fill="@StrokeColor" stroke="@EdgeColor" stroke-width="1.7" stroke-linejoin="round" />
                    </svg>
                    break;

                case "bolt":
                    <svg viewBox="0 0 24 24">
                        <path d="M13.5 2.5L5 13.5h5.5L10 21.5 19 10h-5.8z"
                              fill="@StrokeColor" stroke="@EdgeColor" stroke-width="1.7" stroke-linejoin="round" />
                    </svg>
                    break;

                default:
                    <svg viewBox="0 0 24 24">
                        <path d="M12 3.2c3.6 4.2 5.6 7 5.6 9.4A5.6 5.6 0 0 1 6.4 12.6c0-2.4 2-5.2 5.6-9.4z"
                              fill="@StrokeColor" stroke="@EdgeColor" stroke-width="1.7" stroke-linejoin="round" />
                    </svg>
                    break;
            }
        </span>
    </div>
    <div class="gauge__value" style="color:@ValueColor">@Percent%</div>
</div>

@code {
    private const double Circumference = 107;

    /// <summary>Bu həddin altında stat "diqqət tələb edir" sayılır.</summary>
    private const int LowThreshold = 30;

    [Parameter] public string Label { get; set; } = string.Empty;

    [Parameter] public int Value { get; set; }

    /// <summary>Rəng ailəsi: <c>spark</c>, <c>life</c> və ya <c>primary</c>.</summary>
    [Parameter] public string Family { get; set; } = "primary";

    /// <summary>İkon açarı: <c>food</c>, <c>heart</c>, <c>bolt</c>, <c>drop</c>.</summary>
    [Parameter] public string Icon { get; set; } = "drop";

    private int Percent => Math.Clamp(Value, 0, 100);

    private bool IsLow => Percent < LowThreshold;

    private string DashOffset =>
        (Circumference - Circumference * Percent / 100.0)
            .ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private string StrokeColor => IsLow ? "var(--pp-alert)" : $"var(--pp-{Family})";

    private string EdgeColor => IsLow ? "var(--pp-alert-edge)" : $"var(--pp-{Family}-edge)";

    private string TrackColor => IsLow ? "var(--pp-alert-soft)" : $"var(--pp-{Family}-soft)";

    /* Rəqəm halqadan bir çalar tünd olur ki, ağ fonda oxunsun: parlaq narıncı
       mətn kimi 2.4:1 verir, "deep" isə 4.8:1. Bənövşəyi ailənin tünd çaları
       tarixən "dark" adlanır, digərlərində "deep" — ona görə ayrıca hal. */
    private string ValueColor => IsLow
        ? "var(--pp-alert)"
        : Family == "primary" ? "var(--pp-primary-dark)" : $"var(--pp-{Family}-deep)";
}
