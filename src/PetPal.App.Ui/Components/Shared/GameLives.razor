@inject Loc Loc

@* Oyun canları.

   Üç can qəsdəndir: bir səhv oyunu bitirsəydi, uşaq risk etməkdən qorxardı;
   sonsuz şans olsaydı, diqqətin mənası qalmazdı. İtən can rəngini itirib
   kiçilir — rəng tək daşıyıcı deyil, forma da dəyişir. *@

<div class="lives" role="img" aria-label="@(Loc.T($"{Left} can qaldı", $"{Left} lives left"))">
    @for (var index = 0; index < Total; index++)
    {
        <svg class="lives__heart @(index < Left ? null : "lives__heart--lost")" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 20.6C12 20.6 3.8 15.6 3.8 10.1A4.4 4.4 0 0 1 12 7.3a4.4 4.4 0 0 1 8.2 2.8c0 5.5-8.2 10.5-8.2 10.5z" />
        </svg>
    }
</div>

@code {
    [Parameter] public int Total { get; set; } = 3;

    [Parameter] public int Left { get; set; } = 3;
}
