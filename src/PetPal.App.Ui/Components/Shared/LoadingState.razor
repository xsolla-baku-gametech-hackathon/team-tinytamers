@inject Loc Loc

@* Yüklənmə / boş vəziyyət / xəta üçün ortaq ekran parçaları. *@

@if (IsLoading)
{
    <div class="state">
        <div class="spinner" aria-hidden="true"></div>
        <div>@(LoadingText ?? Loc.T("Yüklənir…", "Loading…"))</div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="state">
        <div class="state__icon" aria-hidden="true">😿</div>
        <div>@Error</div>
        @if (OnRetry.HasDelegate)
        {
            <button class="btn btn--ghost" @onclick="OnRetry">@Loc.T("Yenidən cəhd et", "Try again")</button>
        }
    </div>
}
else
{
    @ChildContent
}

@code {
    [Parameter] public bool IsLoading { get; set; }

    [Parameter] public string? Error { get; set; }

    /// <summary>Verilməyibsə dilə uyğun standart mətn işlədilir.</summary>
    [Parameter] public string? LoadingText { get; set; }

    [Parameter] public EventCallback OnRetry { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
