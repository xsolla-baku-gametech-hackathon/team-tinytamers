@page "/pet-brain"
@implements IDisposable
@inject GameApiClient Api
@inject PetBrainState Brain
@inject AppState State
@inject NavigationManager Navigation
@inject Loc Loc

@* Pet Brain — pet-in növbəti macərəni SƏNƏ görə seçdiyi ekran.

   İki vəziyyəti var:
   1. Giriş — pet düşünür, sonra bir macəra təklif edir; altında yaddaş və
      (nümayiş rejimində) izah paneli.
   2. Macəra — tam ekran səhnə, mərhələ-mərhələ.

   Alt naviqasiyaya ALTINCI element ƏLAVƏ EDİLMİR: bura ana ekrandakı çipdən
   və otaqdan gəlinir. Beş bölmə qəsdən beşdir. *@

<h1 class="visually-hidden-title">@Loc.T("Pet Brain", "Pet Brain")</h1>

<LoadingState IsLoading="_loading" Error="@_error" OnRetry="LoadAsync"
              LoadingText="@ThinkingText">

    @if (_run is not null)
    {
        @* ---------- Macəra ---------- *@
        <ExperienceShell Title="@_run.Title" CurrentStage="_run.CurrentStage"
                         StageCount="_run.StageCount" Difficulty="_run.Difficulty"
                         IsPuzzle="@(_run.Stage?.Kind == PetBrainStageKind.Puzzle)"
                         IsBoard="@HasOwnScene"
                         OnExit="ExitRunAsync">

            <ExperienceScene SceneKey="@_run.SceneKey" Choices="_run.Choices" Icon="@RunIcon"
                             SceneVariant="@_run.Stage?.SceneVariant"
                             SceneImage="@AdventureSceneImage" Awakening="@SceneAwaited" />

            @if (_run.Summary is not null)
            {
                <RunSummary Summary="_run.Summary"
                            PetName="@PetName"
                            PetSpecies="@PetSpecies"
                            PetStage="PetStageValue"
                            PetAccessories="PetAccessoriesValue"
                            SceneKey="@_run.SceneKey"
                            OnDone="FinishAsync" />
            }
            else if (_run.Stage is not null)
            {
                <div class="pbx__stage">
                    @* Pet-in replikası səhnənin üstündə üzür — uşaq üçün ən
                       tanış giriş nöqtəsi onun DEDİYİdir. *@
                    <div class="pbx__bubble" aria-live="polite">@_run.Stage.PetLine</div>

                    @if (!string.IsNullOrWhiteSpace(_run.Stage.MemoryCallback))
                    {
                        @* "Mən bunu xatırlayıram" — yaddaşın GÖRÜNƏN anı.
                           Cümlə serverin strukturlu faktından qurulur; pet
                           uydurmur. *@
                        <div class="pbx__recall" aria-live="polite">
                            <span class="pbx__recall-icon" aria-hidden="true">💭</span>
                            <span class="pbx__recall-label">
                                @Loc.T("Mən bunu xatırlayıram", "I remember this")
                            </span>
                            <span class="pbx__recall-text">@_run.Stage.MemoryCallback</span>
                        </div>
                    }

                    @if (_run.Path.Count > 0)
                    {
                        @* Budaqlanan hekayədə "5-dən 3-cü" ifadəsi YANLIŞDIR:
                           yollar müxtəlif uzunluqdadır. Ona görə uşağa faiz
                           yox, ÖZ CIĞIRI göstərilir. Rəng tək daşıyıcı deyil —
                           hər addımın işarəsi və mətn etiketi var. *@
                        <ol class="pbx-path" aria-label="@Loc.T("Sənin yolun", "Your path")">
                            @foreach (var step in _run.Path)
                            {
                                <li class="pbx-path__step @(step.WasChoice ? "pbx-path__step--choice" : null)">
                                    <span class="pbx-path__icon" aria-hidden="true">@step.Icon</span>
                                    <span class="pbx-path__label">@step.Label</span>
                                </li>
                            }
                        </ol>
                    }

                    <div class="pbx__panel">
                        @* Göstəriş mərhələ boyu QALIR: uşaq onu yadda saxlamağa
                           yox, tətbiq etməyə məşq edir (GameShell ilə eyni qayda).

                           Tapmacada göstərişi LÖVHƏ özü daşıyır (hədəf zolağında
                           və ya qayda sətrində), ona görə burada təkrarlanmır. *@
                        @if (_run.Stage.Kind != PetBrainStageKind.Puzzle)
                        {
                            <p class="pbx__prompt">@_run.Stage.Prompt</p>
                        }

                        @if (_run.Stage.Kind == PetBrainStageKind.Intro)
                        {
                            <button class="btn btn--primary btn--block" disabled="@_busy"
                                    @onclick="ContinueAsync">
                                @Loc.T("Gedək!", "Let us go!")
                            </button>
                        }
                        else if (_run.Stage.Kind == PetBrainStageKind.Consequence)
                        {
                            @* Seçimin NƏTİCƏSİ ayrıca ekrandır: uşaq nə etdiyini
                               dərhal görməlidir. Seçimlə birləşdirmək nəticəni
                               bəzəyə çevirərdi.

                               Hekayənin replikası hamı üçün eynidir; reaksiya
                               isə pet-in XARAKTERİNDƏNDİR. *@
                            @if (!string.IsNullOrWhiteSpace(_run.Stage.PetReaction))
                            {
                                <p class="pbx__reaction">@_run.Stage.PetReaction</p>
                            }

                            <button class="btn btn--primary btn--block" disabled="@_busy"
                                    @onclick="ContinueAsync">
                                @Loc.T("Davam", "Keep going")
                            </button>
                        }
                        else if (_run.Stage.Kind == PetBrainStageKind.Ending)
                        {
                            <button class="btn btn--primary btn--block" disabled="@_busy"
                                    @onclick="CompleteAsync">
                                @Loc.T("Macərəni bitir", "Finish the adventure")
                            </button>
                        }
                        else if (_run.Stage.Puzzle is { } puzzle)
                        {
                            @* Tapmaca uşağa XAS qurulub: mexanikanı oyun üslubu,
                               mövzunu maraqlar, çətinliyi isə mənimsəmə və son
                               nəticə seçib. Doğru cavab burada YOXDUR — o,
                               yalnız serverdə saxlanılır. *@
                            <PuzzleBoard Puzzle="puzzle" Busy="_busy" SceneImage="@PuzzleSceneImage"
                                         SceneAwakening="@SceneAwaited" HintOffer="@_run.Stage.HintOffer"
                                         OnSubmit="SubmitPuzzleAsync" OnHint="HintAsync" />
                        }
                        else
                        {
                            <StageChoices Options="_run.Stage.Options" Prompt="@_run.Stage.Prompt"
                                          Busy="_busy" Pending="@_pending" OnChoose="ChooseAsync" />
                        }
                    </div>
                </div>
            }
        </ExperienceShell>
    }
    else if (_state is { Enabled: false })
    {
        <div class="state">
            <div class="state__icon" aria-hidden="true">🧠</div>
            <div>@Loc.T("Bu bölmə hazırda bağlıdır.", "This section is currently closed.")</div>
        </div>
    }
    else if (_state is { PetIsHatched: false })
    {
        @* Yumurta macəraya çıxmır — mövcud qulluq/söhbət qaydası ilə eyni. *@
        <div class="state">
            <div class="state__icon" aria-hidden="true">🥚</div>
            <div>@Loc.T("Əvvəlcə yumurtanı açmaq lazımdır — sonra birlikdə macərəyə çıxarıq!",
                        "We need to hatch the egg first — then we can go on an adventure!")</div>
            <a class="btn btn--primary" href="care">@Loc.T("Otağa get", "Go to the room")</a>
        </div>
    }
    else if (_state is not null)
    {
        @* ---------- Giriş ---------- *@
        <div class="list-scroll">

            <section class="pbx-intro">
                <div class="pbx-intro__pet">
                    <PetAvatar Stage="PetStageValue" Mood="PetMoodValue" Species="@PetSpecies"
                               Accessories="PetAccessoriesValue" Name="@_state.PetName"
                               Pose="@_state.BondPose" />
                </div>

                <div class="pbx-intro__bubble" aria-live="polite">@_state.Greeting</div>

                <div class="pbx-intro__badge">
                    <span aria-hidden="true">@PersonalityIcon</span>
                    <span>@_state.PersonalityLabel</span>
                </div>

                @* Bağ artıq sadəcə faiz barı DEYİL: uşaq hansı mərtəbədə
                   olduğunu ADI ilə görür. Rəng tək daşıyıcı deyil — pillənin
                   adı, işarəsi və bar birlikdə gəlir. *@
                <div class="pbx-tier">
                    <span class="pbx-tier__emote" aria-hidden="true">@_state.BondEmote</span>
                    <span class="pbx-tier__label">@_state.BondTierLabel</span>
                </div>

                <div class="pbx-bond pbx-bond--intro" role="img"
                     aria-label="@BondAriaLabel">
                    <span class="pbx-bond__fill" style="width:@_state.Bond%"></span>
                </div>

                @if (!string.IsNullOrWhiteSpace(_state.BondUnlockLine))
                {
                    <p class="pbx-tier__line">@_state.BondUnlockLine</p>
                }

                @if (_state.Intent is { } intent)
                {
                    @* Pet-in ÖZ işi. Cümlə serverin təsdiqlədiyi açardan
                       qurulur və heç bir variant uşağı çağırmır, günahlandırmır
                       və ya tələsdirmir. *@
                    <div class="pbx-intent @(intent.IsComplete ? "pbx-intent--done" : null)"
                         aria-live="polite">
                        <span class="pbx-intent__icon" aria-hidden="true">@intent.Icon</span>
                        <span class="pbx-intent__text">@intent.Line</span>
                    </div>
                }
            </section>

            @if (_state.ScreenTimeBlocked)
            {
                <div class="card pbx-blocked">
                    <div class="card__title">@Loc.T("Bugünlük bu qədər", "That is it for today")</div>
                    <p class="card__subtitle">@_state.ScreenTimeMessage</p>
                </div>
            }
            else if (_state.Recommendation is { } recommendation)
            {
                <section class="card pbx-card">
                    <div class="pbx-card__head">
                        <span class="pbx-card__icon" aria-hidden="true">@recommendation.Icon</span>
                        <div>
                            <h2 class="pbx-card__title">@recommendation.Title</h2>
                            <p class="pbx-card__meta">
                                @recommendation.TargetMinutes @Loc.T("dəqiqə", "min")
                                · @DifficultyLabel(recommendation.Difficulty)
                            </p>
                        </div>
                    </div>

                    <p class="pbx-card__intro">@recommendation.Intro</p>

                    @if (!string.IsNullOrWhiteSpace(recommendation.PetLine))
                    {
                        @* Pet-in ÖZ cümləsi — xarakter burada eşidilir. *@
                        <p class="pbx-card__petline">@recommendation.PetLine</p>
                    }

                    @* Düymə səbəblərdən ƏVVƏLdir və bu, ölçmə ilə qərara alınıb:
                       sürüşən sahənin görünən hündürlüyü 550px-dir (kətan 690 −
                       üst boşluq − naviqasiya üçün ayrılan 104px). Səbəblər
                       yuxarıda olanda «Macərəyə başla» 585px-ə düşürdü, yəni
                       uşaq əsas düyməni GÖRMÜRDÜ və sürüşdürməli olurdu.
                       İndi düymə həmişə ekrandadır, izah isə altında qalır. *@
                    <button class="btn btn--primary btn--block pbx-card__start"
                            disabled="@_busy" @onclick="StartAsync">
                        @(_busy ? Loc.T("Hazırlaşırıq…", "Getting ready…") : Loc.T("Macərəyə başla", "Start the adventure"))
                    </button>

                    @* Uşağın "yox" demək HÜQUQU. Bir kart məcburiyyət deyil:
                       "başqa fikir" növbəti təhlükəsiz namizədi gətirir, "sonra"
                       isə sadəcə indi uyğun olmadığını bildirir. Heç biri marağı
                       AZALTMIR — bax ProfileLearningRules. *@
                    <div class="pbx-card__more">
                        @if (recommendation.CanShowAnother)
                        {
                            <button class="btn btn--ghost pbx-card__alt" disabled="@_busy"
                                    @onclick="ShowAnotherAsync">
                                <span aria-hidden="true">🔄</span>
                                @Loc.T("Başqa fikir", "Another idea")
                            </button>
                        }

                        <button class="btn btn--ghost pbx-card__alt" disabled="@_busy"
                                @onclick="NotNowAsync">
                            <span aria-hidden="true">🕒</span>
                            @Loc.T("Sonra", "Later")
                        </button>
                    </div>

                    @if (recommendation.Reasons.Count > 0)
                    {
                        <p class="pbx-reasons__title">@Loc.T("Niyə məhz bu?", "Why this one?")</p>

                        @* Səbəblər uşağa da göstərilir, amma BAL YOX — "kosmos
                           sənin güclü maraqlarındandır" cümləsi uşaq üçün
                           anlaşılandır, "84%" isə deyil.

                           Uşağa ƏN ÇOX ÜÇÜ göstərilir; dördüncüsü (çətinlik
                           qeydi) daha çox valideyn/münsif üçündür və tam siyahı
                           nümayiş panelindədir. *@
                        <ul class="pbx-reasons">
                            @foreach (var reason in recommendation.Reasons.Take(3))
                            {
                                <li class="pbx-reasons__item">
                                    <span aria-hidden="true">✨</span> @reason
                                </li>
                            }
                        </ul>
                    }
                </section>
            }

            @if (_state.BondUnlocks.Count > 0)
            {
                <section class="card pbx-ladder-card">
                    <h2 class="card__title">
                        @Loc.T($"{_state.PetName} ilə dostluğunuz", $"Your friendship with {_state.PetName}")
                    </h2>

                    @* Nərdivan bütöv göstərilir: uşaq irəlidə nə olduğunu
                       görməlidir. Bu, itki mexanikası DEYİL — heç nə geri
                       alınmır, çünki bağ azalmır. *@
                    <ol class="pbx-ladder">
                        @foreach (var unlock in _state.BondUnlocks)
                        {
                            <li class="pbx-ladder__step @(unlock.Reached ? "pbx-ladder__step--reached" : null)">
                                <span class="pbx-ladder__emote" aria-hidden="true">@unlock.Emote</span>

                                <div class="pbx-ladder__body">
                                    <span class="pbx-ladder__label">@unlock.Label</span>
                                    <span class="pbx-ladder__line">@unlock.Line</span>
                                </div>

                                @* Rəng tək daşıyıcı deyil: çatılan pillənin
                                   mətn işarəsi də var. *@
                                <span class="pbx-ladder__state">
                                    @(unlock.Reached ? Loc.T("açıq", "unlocked") : Loc.T("irəlidə", "ahead"))
                                </span>
                            </li>
                        }
                    </ol>
                </section>
            }

            @if (_state.Memories.Count > 0)
            {
                <section class="card pbx-memories-card">
                    <h2 class="card__title">
                        @Loc.T($"{_state.PetName} bunları xatırlayır", $"{_state.PetName} remembers")
                    </h2>

                    @foreach (var memory in _state.Memories)
                    {
                        <div class="pbx-memory">
                            <span class="pbx-memory__icon" aria-hidden="true">@memory.Icon</span>
                            <span class="pbx-memory__text">@memory.Text</span>
                        </div>
                    }
                </section>
            }

            @* Nümayiş paneli YALNIZ konfiqurasiya ilə açılır. Bağlı rejimdə
               uşaq nə bal görür, nə namizəd cədvəli. *@
            @if (_state is { DemoMode: true, Debug: not null })
            {
                <BrainDebugPanel Debug="_state.Debug"
                                 Interests="_state.Interests"
                                 PlayStyles="_state.PlayStyles"
                                 Reasons="RecommendationReasons" />
            }
        </div>
    }
</LoadingState>

@code {
    private PetBrainStateDto? _state;
    private PetBrainRunDto? _run;

    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string? _pending;

    /// <summary>
    /// Hazır hekayə rəsminin <c>data:</c> URI-si və hansı tapmacaya aid olduğu.
    ///
    /// <para>Rəsm AYRICA yüklənir və gec gələ bilər — tapmaca ondan ASILI
    /// DEYİL: ekranda onsuz da eyni həndəsəli deterministik səhnə var, rəsm
    /// hazır olanda yalnız fon dəyişir.</para>
    ///
    /// <para>Yükləmə macəra başlayan kimi başlayır: server qarşıdakı tapmacanı
    /// elə o an verir (<see cref="PetBrainRunDto.UpcomingScene"/>), ona görə
    /// rəsm uşaq giriş və seçim mərhələlərini oynayarkən yüklənir və tapmaca
    /// açılanda artıq hazır olur.</para>
    /// </summary>
    private Guid _sceneOwner;
    private string? _sceneImage;
    private bool _sceneLoading;

    /// <summary>
    /// Rəsmin gəlməyəcəyi bəllidir (server <c>410</c> dedi və ya gözləmə vaxtı
    /// bitdi): yoxlama dayanır, sehrli toz sönür.
    /// </summary>
    private bool _sceneGone;

    private readonly CancellationTokenSource _sceneLifetime = new();

    /// <summary>
    /// Cari tapmacanın AI rəsmi. Qarşıdakı tapmacanın rəsmi qabaqcadan
    /// yüklənir, amma tapmaca açılana qədər GÖSTƏRİLMİR: seçim mərhələsinin
    /// öz səhnəsi uşağın seçimlərini əks etdirir.
    /// </summary>
    private string? PuzzleSceneImage =>
        _run?.Stage?.Puzzle?.PuzzleId == _sceneOwner ? _sceneImage : null;

    /// <summary>
    /// Macəra səhnəsinin AI fonu. Öz lövhəsi olan mexanikada rəsm lövhənin
    /// İÇİNDƏDİR və macəra fonu gizlənir, ona görə eyni rəsm iki dəfə
    /// çəkilmir.
    /// </summary>
    private string? AdventureSceneImage => HasOwnScene ? null : PuzzleSceneImage;

    /// <summary>
    /// AI rəsmi yoldadır, amma hələ ekranda deyil — səhnənin üstündə sehrli toz
    /// parıldayır ki, uşaq dünyanın indicə canlandığını hiss etsin. Rəsm
    /// göstəriləndə, gəlməyəcəyi bəlli olanda və ya AI bağlı olanda toz
    /// yavaşca sönür.
    /// </summary>
    private bool SceneAwaited =>
        SceneTarget is { } target &&
        target.Status != PetBrainIllustrationStatus.Fallback &&
        !(target.PuzzleId == _sceneOwner && _sceneGone) &&
        PuzzleSceneImage is null;

    /// <summary>Rəsmi yüklənməli tapmaca: cari tapmaca, yoxdursa qarşıdakı.</summary>
    private (Guid PuzzleId, PetBrainIllustrationStatus Status)? SceneTarget
    {
        get
        {
            if (_run?.Stage?.Puzzle is { } puzzle)
                return (puzzle.PuzzleId, puzzle.Scene.IllustrationStatus);

            if (_run?.UpcomingScene is { } upcoming)
                return (upcoming.PuzzleId, upcoming.IllustrationStatus);

            return null;
        }
    }

    /// <summary>
    /// Pet "düşünür" mətni. Süni gecikmə YOXDUR — sorğu nə qədər çəkirsə, o
    /// qədər görünür. Uşağı gözlətmək üçün taymer qoymaq hörmətsizlik olardı.
    /// </summary>
    private string ThinkingText =>
        Loc.T($"{PetName} yeni macəranı düşünür…", $"{PetName} is imagining your next adventure…");

    private string PetName => _state?.PetName ?? State.Pet?.Name ?? "Pet";

    // Pet-in görünüşü paylaşılan vəziyyətdən gəlir (ana ekran onsuz da onu
    // yükləyib), ona görə bu ekran pet üçün AYRICA sorğu göndərmir.
    private string PetSpecies => State.Pet?.Species ?? "fox";

    private PetStage PetStageValue => State.Pet?.Stage ?? PetStage.Child;

    private PetMood PetMoodValue => State.Pet?.Mood ?? PetMood.Happy;

    private IReadOnlyCollection<string>? PetAccessoriesValue => State.Pet?.EquippedAccessories;

    private IReadOnlyList<string> RecommendationReasons =>
        _state?.Recommendation?.Reasons ?? new List<string>();

    private string RunIcon => _state?.Recommendation?.Icon ?? "✨";

    /// <summary>
    /// Ekran oxuyucusu üçün bağ mətni: pillənin adı + növbəti pilləyə qalan yol.
    /// Rəqəm tək başına uşağa heç nə demir, pillənin adı isə deyir.
    /// </summary>
    private string BondAriaLabel
    {
        get
        {
            if (_state is null)
                return string.Empty;

            var tier = _state.BondTierLabel;

            return _state.BondNextThreshold > 0
                ? Loc.T(
                    $"Bağ: {tier}. Növbəti pilləyə {_state.BondNextThreshold - _state.Bond} bal qalıb.",
                    $"Bond: {tier}. {_state.BondNextThreshold - _state.Bond} points to the next tier.")
                : Loc.T($"Bağ: {tier}. Ən yuxarı pillə.", $"Bond: {tier}. The highest tier.");
        }
    }

    private string PersonalityIcon => _state?.Personality switch
    {
        PetBrainPersonality.CuriousScientist => "🔬",
        PetBrainPersonality.CreativeCompanion => "🎨",
        PetBrainPersonality.ExplorerCompanion => "🧭",
        PetBrainPersonality.CaringCompanion => "💚",
        _ => "✨"
    };

    private string DifficultyLabel(PetBrainDifficulty difficulty) => difficulty switch
    {
        PetBrainDifficulty.Easy => Loc.T("Rahat", "Gentle"),
        PetBrainDifficulty.Hard => Loc.T("Cəsur", "Bold"),
        _ => Loc.T("Orta", "Steady")
    };

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        var result = await Api.GetPetBrainAsync();
        _loading = false;

        if (!result.Succeeded || result.Value is null)
        {
            // Şəbəkə xətasında boş ekran qalmır: mesaj + "yenidən cəhd et".
            _error = result.Error;
            return;
        }

        _state = result.Value;
        Brain.Apply(_state);

        // Yarımçıq macəra varsa uşaq birbaşa onun içinə düşür — yenilənmə,
        // app-in bağlanması və ya telefon dəyişməsi macərəni itirmir.
        _run = _state.ActiveRun;
    }

    private async Task StartAsync()
    {
        if (_busy || _state?.Recommendation is null)
            return;

        _busy = true;

        var result = await Api.StartPetBrainRunAsync(
            _state.Recommendation.TemplateKey, _state.Recommendation.DecisionId);

        _busy = false;

        if (!result.Succeeded || result.Value is null)
        {
            _error = result.Error;
            return;
        }

        _run = result.Value;
        Brain.Invalidate();
    }

    /// <summary>
    /// «Başqa fikir» — növbəti təhlükəsiz namizəd.
    ///
    /// <para>Bu, marağı AZALTMIR: bir dəfə başqasını istəmək bir mövzunu
    /// sevməmək deyil. Sonsuz da deyil — server sessiya başına limit qoyur və
    /// limit dolanda düymə gizlənir.</para>
    /// </summary>
    private Task ShowAnotherAsync() => SendFeedbackAsync(PetBrainRecommendationFeedback.ShowAnother);

    /// <summary>«Sonra» — indi uyğun deyil. Profilə heç nə yazılmır.</summary>
    private Task NotNowAsync() => SendFeedbackAsync(PetBrainRecommendationFeedback.NotNow);

    private async Task SendFeedbackAsync(PetBrainRecommendationFeedback feedback)
    {
        if (_busy || _state?.Recommendation is null)
            return;

        _busy = true;

        var result = await Api.SendPetBrainFeedbackAsync(_state.Recommendation.DecisionId, feedback);

        _busy = false;

        if (!result.Succeeded || result.Value is null)
        {
            // Cavab getməsə ekran boş qalmır: mövcud kart yerində qalır və
            // uşaq yenidən cəhd edə bilir.
            _error = result.Error;
            return;
        }

        _state = result.Value;
        Brain.Apply(_state);
        _run = _state.ActiveRun;
    }

    /// <summary>Giriş mərhələsi: seçim yoxdur, yalnız "davam".</summary>
    private Task ContinueAsync() => ChooseAsync("continue");

    /// <summary>
    /// Tapmaca cavabı — serverə YALNIZ seçilmiş id-lər gedir.
    ///
    /// <para>Doğruluğu server öz saxladığı həllə qarşı müəyyən edir; burada
    /// göndəriləsi "düzdür" sahəsi ümumiyyətlə yoxdur.</para>
    /// </summary>
    /// <summary>
    /// Mərhələnin ÖZ səhnəsi var — marşrut xəritəsi və ya əjdahanın qanadı.
    /// Belə hallarda dekorativ fon kənara çəkilir (bax ExperienceShell.IsBoard).
    /// </summary>
    private bool HasOwnScene => _run?.Stage?.Puzzle?.Mechanic
        is PetBrainPuzzleMechanic.OrderedRoute or PetBrainPuzzleMechanic.LightFragments;

    protected override void OnAfterRender(bool firstRender) => PrefetchScene();

    /// <summary>
    /// Rəsmi yüklənməli tapmacanı izləyir və yükləməni başladır.
    ///
    /// <para>Yükləmə fon işidir: render dayanmır, uşaq deterministik səhnə ilə
    /// dərhal oynayır. Rəsm hazırdırsa bir dəfə oxunur, hələ çəkilirsə seyrələn
    /// yoxlamalarla gözlənilir. Yoxlama nəticəsiz bitibsə növbəti render onu
    /// yenidən başladır.</para>
    /// </summary>
    private void PrefetchScene()
    {
        if (SceneTarget is not { } target)
            return;

        if (_sceneOwner != target.PuzzleId)
        {
            _sceneOwner = target.PuzzleId;
            _sceneImage = null;
            _sceneLoading = false;
            _sceneGone = false;
        }

        if (_sceneImage is not null || _sceneLoading || _sceneGone ||
            target.Status == PetBrainIllustrationStatus.Fallback)
            return;

        _sceneLoading = true;
        _ = LoadSceneAsync(target.PuzzleId, waitUntilReady: target.Status == PetBrainIllustrationStatus.Pending);
    }

    /// <summary>
    /// Rəsmi ayrıca yükləyir. AI hələ işləyirsə sorğular 250 ms-dən 2
    /// saniyəyə qədər seyrəlir; tapmaca bu vaxt tam işləkdir.
    ///
    /// <para>Server rəsmin gəlməyəcəyini deyəndə (<c>410</c>) və ya gözləmə
    /// vaxtı bitəndə səhnə "gəlməyəcək" sayılır: yoxlama dayanır, sehrli toz
    /// yavaşca sönür və uşaq heç bir xəta görmür.</para>
    ///
    /// <para>Tapmaca dəyişibsə köhnə rəsm ATILIR — səhv səhnə bir kadr belə
    /// göstərilməməlidir. Ekrandan çıxılanda yoxlama səssiz bitir.</para>
    /// </summary>
    private async Task LoadSceneAsync(Guid puzzleId, bool waitUntilReady)
    {
        var delayMilliseconds = 250;
        var attempts = waitUntilReady ? 40 : 1;

        try
        {
            for (var attempt = 0; attempt < attempts; attempt++)
            {
                if (!OwnsScene(puzzleId))
                    return;

                var result = await Api.GetPetBrainIllustrationAsync(puzzleId, _sceneLifetime.Token);

                if (!OwnsScene(puzzleId))
                    return;

                if (result is { Succeeded: true, Value: { Length: > 0 } image })
                {
                    _sceneImage = image;
                    await InvokeAsync(StateHasChanged);
                    return;
                }

                if (result.StatusCode == (int)System.Net.HttpStatusCode.Gone)
                    break;

                if (!waitUntilReady)
                    return;

                if (attempt < attempts - 1)
                {
                    await Task.Delay(delayMilliseconds, _sceneLifetime.Token);
                    delayMilliseconds = Math.Min(delayMilliseconds * 2, 2_000);
                }
            }

            _sceneGone = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (_sceneLifetime.IsCancellationRequested)
        {
        }
        finally
        {
            if (_sceneOwner == puzzleId)
                _sceneLoading = false;
        }
    }

    private bool OwnsScene(Guid puzzleId) =>
        !_sceneLifetime.IsCancellationRequested &&
        _sceneOwner == puzzleId &&
        SceneTarget?.PuzzleId == puzzleId;

    private async Task SubmitPuzzleAsync(List<string> selectedIds)
    {
        if (_busy || _run?.Stage is null)
            return;

        _busy = true;

        var result = await Api.SubmitPetBrainPuzzleAsync(
            _run.RunId, _run.Stage.Index, selectedIds, NodeIdOrNull);

        _busy = false;

        if (!result.Succeeded || result.Value is null)
        {
            _error = result.Error;
            return;
        }

        _run = result.Value;

        await CompleteIfFinishedAsync();
    }

    /// <summary>
    /// Cari ekranın açarı — budaqlanan hekayədə serverin təsdiq üçün gözlədiyi
    /// dəyər; xətti macərada boş qalır.
    /// </summary>
    private string? NodeIdOrNull =>
        string.IsNullOrEmpty(_run?.Stage?.NodeId) ? null : _run.Stage.NodeId;

    /// <summary>
    /// Macəra bitibsə yekunu açır.
    ///
    /// <para>Xətti macərada şərt "bütün mərhələlər keçildi"dir; budaqlanan
    /// hekayədə isə SONLUQ ekranıdır — orada uşaq özü "bitir" düyməsinə basır,
    /// çünki sonluq mətni oxunmağa dəyər.</para>
    /// </summary>
    private async Task CompleteIfFinishedAsync()
    {
        if (_run?.Stage is null && _run is not null && _run.CurrentStage >= _run.StageCount)
            await CompleteAsync();
    }

    private async Task ChooseAsync(string optionKey)
    {
        if (_busy || _run?.Stage is null)
            return;

        _busy = true;
        _pending = optionKey;

        var result = await Api.SubmitPetBrainChoiceAsync(
            _run.RunId, _run.Stage.Index, optionKey, NodeIdOrNull);

        _busy = false;
        _pending = null;

        if (!result.Succeeded || result.Value is null)
        {
            _error = result.Error;
            return;
        }

        _run = result.Value;

        // Bütün mərhələlər bitdi: yekunu server hesablayır və mükafatı
        // DƏQİQ BİR DƏFƏ verir — təkrar çağırış təhlükəsizdir.
        await CompleteIfFinishedAsync();
    }

    private async Task HintAsync()
    {
        if (_busy || _run?.Stage is null)
            return;

        _busy = true;

        var result = await Api.RequestPetBrainHintAsync(_run.RunId, _run.Stage.Index, NodeIdOrNull);

        _busy = false;

        if (result is { Succeeded: true, Value: not null })
            _run = result.Value;
    }

    private async Task CompleteAsync()
    {
        if (_run is null)
            return;

        var result = await Api.CompletePetBrainRunAsync(_run.RunId);

        if (result is { Succeeded: true, Value: not null })
        {
            _run = result.Value;

            // Pet-in yeni yaşı, XP-si və təzəcə açılan əşyası ana ekranda da
            // görünməlidir, ona görə paylaşılan vəziyyət yenilənir.
            var pet = await Api.GetPetAsync();
            if (pet is { Succeeded: true, Value: not null })
                State.ApplyPet(pet.Value);
        }
        else
        {
            _error = result.Error;
        }
    }

    /// <summary>
    /// Çıxış uşağın qərarıdır və iki hal QƏSDƏN fərqlidir:
    ///
    /// <list type="bullet">
    ///   <item><b>✕ düyməsi</b> — "bu macərəni istəmirəm". Run yarımçıq
    ///   işarələnir, mükafat verilmir və mənalı yarımçıq qoyma siqnal olaraq
    ///   yazılır (yalnız ən azı bir mərhələ keçilibsə — səhv toxunuş fikir
    ///   bildirmək deyil, bax ProfileLearningRules.ForAbandon).</item>
    ///   <item><b>Sadəcə getmək</b> — ekranı yeniləmək, alt naviqasiya ilə başqa
    ///   bölməyə keçmək, app-i bağlamaq. Run AKTİV qalır və uşaq ana ekrandakı
    ///   çipdən ("Davam") ora qayıda bilir.</item>
    /// </list>
    ///
    /// Yəni macəra heç vaxt təsadüfən itmir; onu yalnız uşaq özü bağlayır.
    /// </summary>
    private async Task ExitRunAsync()
    {
        if (_run is { Status: PetBrainRunStatus.Active })
            await Api.AbandonPetBrainRunAsync(_run.RunId);

        _run = null;
        Brain.Invalidate();

        await LoadAsync();
    }

    private async Task FinishAsync()
    {
        _run = null;
        Brain.Invalidate();

        await LoadAsync();
    }

    public void Dispose()
    {
        _sceneLifetime.Cancel();
        _sceneLifetime.Dispose();
    }
}
