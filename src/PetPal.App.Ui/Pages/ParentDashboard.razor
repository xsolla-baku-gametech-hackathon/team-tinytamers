    private bool IsCurrentLanguage(string code) =>
        string.Equals(_dashboard?.LanguageCode ?? Loc.Language, code, StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// Dil serverdə uşağın profilinə yazılır (sual bankı da ondan asılıdır) və
    /// dəyişən profil elə indi aktivdirsə, interfeys dərhal həmin dilə keçir —
    /// valideyn nəticəni yenidən girmədən görür.
    /// </summary>
    private async Task ChangeLanguageAsync(string code)
    {
        var childId = Session.ActiveChildId;
        if (childId is null || _savingLanguage)
            return;

        _savingLanguage = true;
        _languageSaved = false;
        _error = null;

        var result = await ParentApi.UpdateLanguageAsync(childId.Value, code);

        _savingLanguage = false;

        if (!result.Succeeded || result.Value is null)
        {
            _error = result.Error;
            return;
        }

        if (_dashboard is not null)
            _dashboard.LanguageCode = result.Value.LanguageCode;

        await Session.UseChildLanguageAsync(result.Value.LanguageCode);
        _languageSaved = true;

        // Panelin bir hissəsi SERVERDƏN gəlir (müşahidələr, bacarıq adları) —
        // onlar yalnız yeni sorğuda dil dəyişir, yoxsa yarısı köhnə dildə qalır.
        await LoadAsync();
    }

    /// <summary>Sütun hündürlüyü ən yüksək günə nisbətdə hesablanır ki, qrafik həmişə oxunaqlı olsun.</summary>
    private int BarHeight(int tasksDone)
    {
        var max = _dashboard?.Last7Days.Max(p => p.TasksDone) ?? 0;
        if (max <= 0)
            return 3;

        return Math.Clamp(tasksDone * 100 / max, 3, 100);
    }
