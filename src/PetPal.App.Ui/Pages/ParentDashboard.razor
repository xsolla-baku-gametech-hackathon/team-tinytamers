    {
        "ContactInfo" => Loc.T("şəxsi məlumat", "personal detail"),
        "Injection" => Loc.T("pet-in qaydalarını dəyişmək cəhdi", "tried to change the pet's rules"),
        "Repetition" => Loc.T("təkrarlanan simvollar", "repeated characters"),
        "TooLong" => Loc.T("çox uzun", "too long"),
        _ => Loc.T("cavablanmadı", "not answered")
    };

    private async Task SaveAsync()
    {
        var childId = Session.ActiveChildId;
        if (childId is null)
            return;

        _saving = true;
        _saved = false;

        var result = await ParentApi.UpdateScreenTimeAsync(childId.Value, _settings);

        _saving = false;

        if (!result.Succeeded)
        {
            _error = result.Error;
            return;
        }

