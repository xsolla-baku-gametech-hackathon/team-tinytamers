                        <div class="progress" style="height:10px;width:74%">
                            <div class="progress__bar @(_bathStep == BathStep.Rinse ? "progress__bar--water" : null)"
                                 style="width:@BathPercent%"></div>
                        </div>
                    </div>
                </div>
            }

            @* ===== Yataq otağı =====
               Şkaf kimi ayrıca tam ekran otaq. Uşağın gördüyü iş sadədir: pet
               yatağa uzanır, o isə lampanı söndürür. Sürükləmə yoxdur — yatmaq
               uşaq üçün pet-i daşımaq deyil, işığın sönməsidir. *@
            @if (_mode == CareMode.Sleep)
            {
                <div class="bedroom @(_lightsOff ? "bedroom--dark" : null)"
                     role="dialog" aria-modal="true" aria-label="@Loc.T("Yataq otağı", "Bedroom")">
                    <div class="bedroom__room" data-room>
                        <div class="bedroom__decor" aria-hidden="true">
                            @* Divar qatı yuxarı interfeys sahəsini boş saxlayıb naxışı aşağıdan başladır. *@
                            <div class="bedroom__wall">
                              <div class="bedroom__wall-pattern"></div>
                              <div class="bedroom__night-light">
                                <div class="bedroom__night-light-star"></div>
                              </div>
                            </div>
                            <div class="bedroom__shelf"></div>
                            <div class="bedroom__garland"></div>

                            @* Pəncərə eyni quruluşda günəş, ay və ulduzların vəziyyətini dəyişməyə imkan verir. *@
