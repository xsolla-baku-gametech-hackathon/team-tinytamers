@page "/care"
@implements IAsyncDisposable
@inject GameApiClient Api
@inject AppState State
@inject NavigationManager Navigation
@inject IJSRuntime Js
@inject Loc Loc

@* Ekranın qəhrəmanı pet-dir — mobil oyunlardakı kimi. Düymələr yazısız
   dairələrdir və hər biri abstrakt "əməliyyat" deyil, ayrıca səhnə açır:
   qabdan yem seçilib ağıza aparılır, sabun bədəndə gəzdirilib köpüklənir və
   köpük su ilə yuyulur, pet tutulub yatağa aparılır.

   Yumurta rejimində bunların heç biri yoxdur — orada tək bir iş var. *@

<h1 class="visually-hidden-title">@Loc.T("Otaq", "Room")</h1>

<LoadingState IsLoading="_loading" Error="@_error" OnRetry="LoadAsync" LoadingText="@Loc.T("Pet çağırılır…", "Calling your pet…")">
    @if (_pet is not null)
    {
        @* Səhnə yalnız otaq açıq DEYİLKƏN çəkilir. Səbəb texnikidir: pet-in
           SVG-si `data-pet-target` daşıyır və JS sürükləməni sənədin BİRİNCİ
           belə elementinə bağlayır — səhnə arxada qalsa, sabun görünməyən
           pet-in üstünə düşür. *@
        @if (!IsRoomOpen)
        {
        <section class="stage">
            <div class="stage__sky" aria-hidden="true"></div>
            <div class="stage__ground" aria-hidden="true"></div>

            @if (!string.IsNullOrWhiteSpace(BubbleText))
            {
                <div class="stage__bubble">@BubbleText</div>
            }

            @if (!string.IsNullOrWhiteSpace(_pet.BondRoomDecor))
            {
                @* Bağ pilləsinin QAZANDIRDIĞI otaq detalı. Açar serverdəndir;
                   naməlum açar heç nə çəkmir. *@
                <div class="stage__decor stage__decor--@_pet.BondRoomDecor" aria-hidden="true"></div>
            }

            <div class="stage__pet">
                @* Poza da pillədəndir: duruş bir neçə piksel dəyişir — pet-in
                   kim olduğu yox. *@
                <PetAvatar Stage="_pet.Stage" Mood="_pet.Mood" Species="@_pet.Species" Name="@_pet.Name"
                           Accessories="_pet.EquippedAccessories" Pose="@_pet.BondPose"
                           MouthOpen="MouthOpen" ReactionClass="@_reaction" />
            </div>
        </section>
        }

        @if (!_pet.IsHatched)
        {
            <div class="card">
                <h2 class="card__title">🥚 @Loc.T("Yumurtanı aç", "Hatch the egg")</h2>
                <p class="card__subtitle">
                    @Loc.T($"Sual həll edib ulduz qazan. {_pet.HatchStarCost} ulduz toplananda {_pet.Name} yumurtadan çıxacaq!", $"Solve questions and earn stars. When you reach {_pet.HatchStarCost} stars, {_pet.Name} will hatch!")
                </p>

                <div class="progress__row" style="margin-top:14px">
                    <span>⭐ @State.Wallet.Stars / @_pet.HatchStarCost</span>
                    <span>@HatchPercent%</span>
                </div>
                <div class="progress progress--goal">
                    <div class="progress__bar" style="width:@HatchPercent%"></div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_actionError))
                {
                    <div class="alert alert--error" style="margin-top:14px">@_actionError</div>
                }

                <button class="btn btn--primary btn--block" style="margin-top:14px"
                        disabled="@(_busy || State.Wallet.Stars < _pet.HatchStarCost)" @onclick="HatchAsync">
                    @if (_busy)
                    {
                        <text>@Loc.T("Açılır…", "Hatching…")</text>
                    }
                    else if (State.Wallet.Stars < _pet.HatchStarCost)
                    {
                        <text>@Loc.T($"Daha {_pet.HatchStarCost - State.Wallet.Stars} ulduz lazımdır", $"{_pet.HatchStarCost - State.Wallet.Stars} more stars needed")</text>
                    }
                    else
                    {
                        <text>✨ @Loc.T("Yumurtanı aç", "Hatch the egg")</text>
                    }
                </button>

                <a class="btn btn--ghost btn--block" style="margin-top:10px" href="learn">📖 @Loc.T("Ulduz qazanmağa get", "Go and earn stars")</a>
            </div>
        }
        else
        {
            @* Statlar oyun HUD-u kimi: kompakt, adsız, rəngi özü danışır. *@
            <div class="vitals">
                <div class="vitals__stat" title="@Loc.T("Sevinc", "Joy")"><span aria-hidden="true">😊</span><span class="vitals__track"><span class="vitals__fill @FillClass(_pet.Happiness)" style="width:@_pet.Happiness%"></span></span></div>
                <div class="vitals__stat" title="@Loc.T("Toxluq", "Fullness")"><span aria-hidden="true">🍖</span><span class="vitals__track"><span class="vitals__fill @FillClass(_pet.Fullness)" style="width:@_pet.Fullness%"></span></span></div>
                <div class="vitals__stat" title="@Loc.T("Enerji", "Energy")"><span aria-hidden="true">⚡</span><span class="vitals__track"><span class="vitals__fill @FillClass(_pet.Energy)" style="width:@_pet.Energy%"></span></span></div>
                <div class="vitals__stat" title="@Loc.T("Təmizlik", "Cleanliness")"><span aria-hidden="true">🧼</span><span class="vitals__track"><span class="vitals__fill @FillClass(_pet.Cleanliness)" style="width:@_pet.Cleanliness%"></span></span></div>
            </div>

            <div class="dock">
                <button class="dock__btn @(_mode == CareMode.Feed ? "dock__btn--on" : null) @(_pet.Fullness < 50 ? "dock__btn--alert" : null)"
                        disabled="@_busy" @onclick="() => SetModeAsync(CareMode.Feed)" aria-label="@Loc.T("Yedizdir", "Feed")">
                    <span aria-hidden="true">🍖</span>
                    <span class="dock__cost">⭐@CheapestFoodCost+</span>
                </button>
                <button class="dock__btn" disabled="@_busy" @onclick="GoToGames" aria-label="@Loc.T("Oyunlar", "Games")">
                    <span aria-hidden="true">🎾</span>
                </button>
                <button class="dock__btn @(_mode == CareMode.Bath ? "dock__btn--on" : null) @(_pet.Cleanliness < 50 ? "dock__btn--alert" : null)"
                        disabled="@_busy" @onclick="() => SetModeAsync(CareMode.Bath)" aria-label="@Loc.T("Çimizdir", "Bath")">
                    <span aria-hidden="true">🧼</span>
                </button>
                <button class="dock__btn @(_mode == CareMode.Sleep ? "dock__btn--on" : null)"
                        disabled="@_busy" @onclick="() => SetModeAsync(CareMode.Sleep)" aria-label="@Loc.T("Yatızdır", "Put to sleep")">
                    <span aria-hidden="true">🛏️</span>
                </button>
                <button class="dock__btn @(_closetOpen ? "dock__btn--on" : null)"
                        disabled="@_busy" @onclick="OpenClosetAsync" aria-label="@Loc.T("Şkaf", "Closet")">
                    <span aria-hidden="true">👕</span>
                </button>
            </div>

            @* Səhnə, statlar və dok yerində qalır; aşağıdakı panel və paltar rəfi
               isə əşya sayına görə uzanır, ona görə sürüşən hissə budur. *@
            <div class="list-scroll list-scroll--care">

            @* Yem vermək artıq burada deyil: o da hamam və yataq otağı kimi
               ayrıca tam ekran otaqdır (bax "Yemək otağı" aşağıda). Bu sahədə
               yalnız xəta və mükafat mesajları qalır. *@
            @if (!string.IsNullOrWhiteSpace(_actionError))
            {
                <div class="alert alert--error">@_actionError</div>
            }

            @if (_newAccessories.Count > 0)
            {
                <div class="feedback feedback--correct">
                    <div>🎁 @Loc.T("Yeni əşya açıldı!", "New item unlocked!")</div>
                    @foreach (var accessory in _newAccessories)
                    {
                        <div class="reward-pop">@accessory.Icon @accessory.Name</div>
                    }
                </div>
            }
            </div>

            @* ===== Paltar dəyişmə otağı =====
               Şkaf səhifənin bir parçası deyil, AYRICA TAM EKRAN otaqdır: uşaq
               içəri girir, pet-i güzgünün qarşısında geyindirir və çıxır.
               Statlar, dok, kartlar və alt naviqasiya burada görünmür — janr
               konvensiyası budur və diqqət yalnız pet-in üstündə qalmalıdır. *@
            @if (_closetOpen)
            {
                <div class="closet" role="dialog" aria-modal="true" aria-label="@Loc.T("Paltar dəyişmə otağı", "Dressing room")">
                    @* Otaq digər otaqlarla eyni sistemdədir: sabit 390x620
                       qutu, miqyas JS-dən (fitRooms). Əvvəl faizlə idi və
                       uzun ekranda güzgü dartılırdı. *@
                    <div class="closet__room" data-room>
                        <div class="closet__decor" aria-hidden="true">
                            @* Otağın həcmi və döşəmə perspektivi ilk baxışda hiss olunsun deyə arxa qatlar ayrılır. *@
                            <div class="closet__wall"></div>
                            <div class="closet__floor"></div>
                            <div class="closet__planks"></div>
                            <div class="closet__baseboard"></div>
                            <div class="closet__floor-depth"></div>
                            <div class="closet__floor-shadow"></div>

                            @* Alt panel gələndə də mərkəz sakit və səliqəli qalsın deyə xalça iri, sadə halqa kimi işlənir. *@
                            <div class="closet__rug"></div>

                            @* Petin arxasında aydın fokus və başının üstündə işıqlı tağ qalması üçün güzgü mərkəzə yerləşir. *@
                            <div class="closet__mirror">
                              <div class="closet__mirror-glass"></div>
                              <div class="closet__mirror-foot closet__mirror-foot--left"></div>
                              <div class="closet__mirror-foot closet__mirror-foot--right"></div>
                              <i class="closet__bulb closet__bulb--01"></i>
                              <i class="closet__bulb closet__bulb--02"></i>
                              <i class="closet__bulb closet__bulb--03"></i>
                              <i class="closet__bulb closet__bulb--04"></i>
                              <i class="closet__bulb closet__bulb--05"></i>
                              <i class="closet__bulb closet__bulb--06"></i>
                              <i class="closet__bulb closet__bulb--13"></i>
                              <i class="closet__bulb closet__bulb--14"></i>
                              <i class="closet__bulb closet__bulb--15"></i>
                              <i class="closet__bulb closet__bulb--16"></i>
                              <i class="closet__bulb closet__bulb--17"></i>
                            </div>

                            @* Geyim ekranının məqsədi sözsüz anlaşılsın deyə solda dörd fərqli geyim silueti göstərilir. *@
                            <div class="closet__wardrobe">
                              <div class="closet__rail"></div>
                              <div class="closet__garment closet__garment--tee">
                                <span class="closet__hanger"></span>
                                <span class="closet__cloth closet__cloth--tee"></span>
                              </div>
                              <div class="closet__garment closet__garment--dress">
                                <span class="closet__hanger"></span>
                                <span class="closet__cloth closet__cloth--dress"></span>
                              </div>
                              <div class="closet__garment closet__garment--jacket">
                                <span class="closet__hanger"></span>
                                <span class="closet__cloth closet__cloth--jacket"></span>
                              </div>
                              <div class="closet__garment closet__garment--scarf">
                                <span class="closet__hanger"></span>
                                <span class="closet__cloth closet__cloth--scarf"></span>
                              </div>
                            </div>

                            @* Sol tərəfdəki geyimləri tarazlamaq və otağa yığcam dolab zənginliyi vermək üçün sağda rəf qurulur. *@
                            <div class="closet__shelf">
                              <div class="closet__hatbox closet__hatbox--large"></div>
                              <div class="closet__hatbox closet__hatbox--small"></div>
                              <div class="closet__shelf-board closet__shelf-board--top"></div>
                              <div class="closet__folds">
                                <span class="closet__fold closet__fold--one"></span>
                                <span class="closet__fold closet__fold--two"></span>
                                <span class="closet__fold closet__fold--three"></span>
                                <span class="closet__fold closet__fold--four"></span>
                              </div>
                              <div class="closet__shelf-board closet__shelf-board--bottom"></div>
                            </div>

                            @* Sol aşağı künc uşaq otağı kimi rahat görünsün və pet sahəsi açıq qalsın deyə balaca puf kənara sıxılır. *@
                            <div class="closet__pouf">
                              <div class="closet__pouf-body"></div>
                              <div class="closet__pouf-top"></div>
                              <span class="closet__pouf-button"></span>
                            </div>

                            @* Sağ kənara yumşaq canlılıq gəlməsi və kompozisiyanın pufla tarazlanması üçün hündür bitki seçilir. *@
                            <div class="closet__plant">
                              <span class="closet__stem closet__stem--left"></span>
                              <span class="closet__stem closet__stem--right"></span>
                              <span class="closet__leaf closet__leaf--one"></span>
                              <span class="closet__leaf closet__leaf--two"></span>
                              <span class="closet__leaf closet__leaf--three"></span>
                              <span class="closet__leaf closet__leaf--four"></span>
                              <span class="closet__leaf closet__leaf--five"></span>
                              <div class="closet__pot"></div>
                              <div class="closet__pot-rim"></div>
                            </div>

                            @* Başlıq sahəsi sakit qalsın, amma otaqda isti tavan işığı hiss edilsin deyə lampanın həcmi sağda və aşağıda açılır. *@
                            <div class="closet__lamp">
                              <div class="closet__lamp-canopy"></div>
                              <div class="closet__lamp-cord"></div>
                              <div class="closet__lamp-shade"></div>
                              <div class="closet__lamp-bulb"></div>
                            </div>

                            @* Kənarlar səhnə pərdəsi kimi yumşalsın və bütün ekran geyinmə kabinəsinə çevrilsin deyə pərdələr çərçivə yaradır. *@
                            <div class="closet__rod"></div>
                            <div class="closet__curtain closet__curtain--left"></div>
                            <div class="closet__curtain closet__curtain--right"></div>
                        </div>

                        @* Pet güzgünün qarşısındadır: taxılan paltar elə həmin an,
                           elə həmin yerdə görünür. *@
                        @if (_lookImage is not null)
                        {
                            <img class="closet__look" src="@_lookImage"
                                 alt="@Loc.T("Güzgüdə pet-in dizayn paltarı", "Your pet's designed outfit in the mirror")" />
                        }

                        @if (_lookImage is null)
                        {
                            <div class="closet__pet">
                                <PetAvatar Stage="_pet.Stage" Mood="_pet.Mood" Species="@_pet.Species" Name="@_pet.Name"
                                           Accessories="_pet.EquippedAccessories" ReactionClass="@_reaction" />
                            </div>
                        }
                    </div>
                    <div class="closet__bar">
                        <button class="overlay-close" @onclick="CloseCloset" aria-label="@Loc.T("Otaqdan çıx", "Leave the room")">✕</button>

                        <div class="closet__bar-actions">
                            @if (EquippedCount > 0)
                            {
                                <button class="closet__clear" disabled="@_busy" @onclick="ClearAccessoriesAsync">
                                    Hamısını çıxart
                                </button>
                            }

                            <button class="closet__design @(_studioOpen ? "closet__design--on" : null)"
                                    aria-pressed="@_studioOpen" @onclick="ToggleStudio">
                                ✨ @Loc.T("Öz paltarın", "Your own outfit")
                            </button>
                        </div>
                    </div>

                    <WardrobeStudio Open="_studioOpen" OnClose="CloseStudio" OnLookChanged="ShowLook" />

                    @if (!string.IsNullOrWhiteSpace(_actionError))
                    {
                        <div class="closet__error">@_actionError</div>
                    }

                    @* Növü dəyişmək də şəxsiləşdirmədir və yeri elə buradır: rəfin
                       üstündə kiçik sıra. Yaş, statlar və açılmış əşyalar dəyişmir —
                       yalnız görünüş. *@
                    <div class="closet__species">
                        @foreach (var option in DisplayNames.SpeciesOptions(Loc))
                        {
                            var key = option.Key;

                            <button class="closet__species-pick @(_pet.Species == key ? "closet__species-pick--on" : null)"
                                    disabled="@(_busy || _pet.Species == key)"
                                    aria-pressed="@(_pet.Species == key)"
                                    aria-label="@option.Label"
                                    @onclick="() => ChangeSpeciesAsync(key)">
                                <PetAvatar Species="@key" Stage="PetStage.Baby" Mood="PetMood.Happy" Name="@option.Label" />
                            </button>
                        }
                    </div>

                    @* Rəf ekranın altında lentdir: bir toxunuş geyindirir,
                       ikincisi çıxarır. Kilidli əşya gizlədilmir — uşaq şərti
                       görməlidir. *@
                    <div class="closet__tray">
                        @foreach (var accessory in _pet.Accessories)
                        {
                            var item = accessory;

                            <button class="closet__item @(item.IsUnlocked ? null : "closet__item--locked") @(item.IsEquipped ? "closet__item--on" : null)"
                                    disabled="@(_busy || !item.IsUnlocked)"
                                    aria-pressed="@item.IsEquipped"
                                    @onclick="() => ToggleAccessoryAsync(item)">
                                <span class="closet__icon" aria-hidden="true">@(item.IsUnlocked ? item.Icon : "🔒")</span>
                                <span class="closet__name">@item.Name</span>
                                <span class="closet__meta">@AccessoryMeta(item)</span>
                            </button>
                        }
                    </div>
                </div>
            }

            @* ===== Yemək otağı =====
               Yem vermək əvvəl kartın içindəki siyahı idi: pet yuxarıdakı balaca
               səhnədə qalır, yemlər isə aşağıdakı ağ qutuda dururdu — uşaq ikisini
               bir səhnə kimi görmürdü və "yemi ağzına apar" göstərişi boşluqda
               asılı qalırdı. İndi digər üç qulluq işi ilə eyni sistemdədir. *@
            @if (_mode == CareMode.Feed)
            {
                <div class="kitchen" role="dialog" aria-modal="true" aria-label="@Loc.T("Yemək otağı", "Dining room")">
                    <div class="kitchen__room" data-room>
                        <div class="kitchen__decor" aria-hidden="true">
                            <div class="kitchen__wall">
                              <div class="kitchen__wall-pattern"></div>
                            </div>

                            <div class="kitchen__shelf">
                              <div class="kitchen__jar kitchen__jar--one"></div>
                              <div class="kitchen__jar kitchen__jar--two"></div>
                              <div class="kitchen__jar kitchen__jar--three"></div>
                              <div class="kitchen__shelf-board"></div>
                            </div>

                            <div class="kitchen__window">
                              <div class="kitchen__window-view">
                                <div class="kitchen__sun"></div>
                                <div class="kitchen__window-hill"></div>
                              </div>
                            </div>

                            <div class="kitchen__lamp">
                              <div class="kitchen__lamp-cord"></div>
                              <div class="kitchen__lamp-shade"></div>
                              <div class="kitchen__lamp-glow"></div>
                            </div>

                            <div class="kitchen__skirting"></div>
                            <div class="kitchen__floor">
                              <div class="kitchen__floor-tiles"></div>
                            </div>
                            <div class="kitchen__rug"></div>

                            <div class="kitchen__cupboard">
                              <div class="kitchen__pot"></div>
                              <div class="kitchen__cupboard-top"></div>
                              <div class="kitchen__cupboard-body">
                                <div class="kitchen__cupboard-door"></div>
                                <div class="kitchen__cupboard-door"></div>
                              </div>
                            </div>
                        </div>

                        @* MouthOpen burada da lazımdır: yem ağıza yaxınlaşanda pet
                           ağzını açır və uşaq harada buraxacağını görür. *@
                        <div class="kitchen__pet">
                            <PetAvatar Stage="_pet.Stage" Mood="_pet.Mood" Species="@_pet.Species" Name="@_pet.Name"
                                       Accessories="_pet.EquippedAccessories"
                                       MouthOpen="MouthOpen" ReactionClass="@_reaction" />
                        </div>

                        @* Qab pet-in ÖNÜNDƏDİR — pəncələr onun arxasında qalır. *@
                        <div class="kitchen__front" aria-hidden="true">
                            <svg class="kitchen__bowl" viewBox="0 0 128 50" fill="none">
                                <ellipse cx="64" cy="44" rx="58" ry="6" fill="rgba(96,74,46,0.18)" />
                                <path d="M10 14 H118 C120 32 106 44 84 46 H44 C22 44 8 32 10 14 Z"
                                      fill="var(--kt-wood)" stroke="var(--kt-wood-edge)" stroke-width="5" stroke-linejoin="round" />
                                <ellipse cx="64" cy="14" rx="56" ry="12" fill="var(--kt-wood-lift)" stroke="var(--kt-wood-edge)" stroke-width="5" />
                                <ellipse cx="64" cy="15" rx="42" ry="7" fill="#8A5A2A" opacity="0.35" />
                            </svg>
                        </div>
                    </div>

                    @* Cüzdan otağın İÇİNDƏ göstərilir. Üst panel burada gizlidir
                       (otaq tam ekrandır), yemlərin isə qiyməti var — uşaq nə
                       qədər ulduzu olduğunu görmədən seçim edə bilməz və bağlı
                       yemin niyə bağlı olduğunu anlamaz. *@
                    <div class="kitchen__bar">
                        <button class="overlay-close" @onclick="() => SetModeAsync(CareMode.None)"
                                aria-label="@Loc.T("Yemək otağından çıx", "Leave the dining room")">✕</button>

                        <span class="room-wallet" aria-label="@Loc.T($"{State.Wallet.Stars} ulduzun var", $"You have {State.Wallet.Stars} stars")">
                            <span class="room-wallet__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="20" height="20">
                                    <path d="M12 3.2l2.6 5.6 6.1.8-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6L3.3 9.6l6.1-.8z"
                                          fill="var(--pp-spark)" stroke="var(--pp-spark-edge)" stroke-width="1.6"
                                          stroke-linejoin="round" />
                                </svg>
                            </span>@State.Wallet.Stars
                        </span>
                    </div>

                    @* Süfrə: yem seçimi burada, otağın öz səthində. Qiymət və təsir
                       gizlədilmir — uşaq seçməzdən əvvəl nə xərclədiyini görür. *@
                    <div class="kitchen__tools">
                        <div class="kitchen__hint">@FeedHint</div>

                        @* Pet doyanda süfrə bağlanır. Otaq yem veriləndən sonra
                           AÇIQ qaldığına görə bu vacibdir: uşaq yemi ağza qədər
                           aparıb sonda "toxdur" cavabı almamalıdır — imtina yenə
                           də işin əvvəlində olur. *@
                        <div class="tray tray--counter">
                            @foreach (var food in _foods)
                            {
                                var canServe = !PetIsFull && State.Wallet.Stars >= food.StarCost;

                                <button class="tray__item @(canServe ? null : "tray__item--locked") @(food.IsTreat ? "tray__item--treat" : null)"
                                        disabled="@(_busy || !canServe)" title="@food.Effect"
                                        @onpointerdown="e => StartFoodDragAsync(food, e)">
                                    <span class="tray__icon" data-drag-id="@FoodDragId(food)" aria-hidden="true">@food.Icon</span>
                                    <span class="tray__name">@food.Name</span>
                                    <span class="tray__cost">⭐@food.StarCost</span>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }

            @* ===== Hamam =====
               Çimizdirmə də ayrıca tam ekran otaqdır: pet vannada dayanır, uşaq
               sabunu bədəndə gəzdirir, sonra suyu. Effektləri (köpük, sıçrayış,
               damcı, parıltı) JS barmağın getdiyi yerdə yaradır. *@
            @if (_mode == CareMode.Bath)
            {
                <div class="bathroom" role="dialog" aria-modal="true" aria-label="@Loc.T("Hamam", "Bathroom")">
                    <div class="bathroom__room" data-room>
                        <div class="bathroom__decor" aria-hidden="true">
                            <div class="bath__wall"></div>
                            <div class="bath__baseboard"></div>
                            <div class="bath__floor"></div>

                            <div class="fx__steam bath__steam">
                                <span class="fx__steam-wisp fx__steam-wisp--1"></span>
                                <span class="fx__steam-wisp fx__steam-wisp--2"></span>
                                <span class="fx__steam-wisp fx__steam-wisp--3"></span>
                            </div>

                            <div class="bath__hook"></div>
                            <div class="bath__towel"></div>

                            @* Divar borusu və şlanq otaq qutusu ilə EYNİ 390x620
                               koordinat sistemində çəkilir, ona görə şlanqın ucu
                               duş başlığının sapına piksel dəqiqliyi ilə oturur.
                               Əvvəl ikisi ayrı-ayrı CSS qövsləri idi: aralarında
                               boşluq qalırdı və qövsün alt ucu otağın ortasında
                               mənası olmayan bir cizgi kimi görünürdü. *@
                            <svg class="bath__plumbing" viewBox="0 0 390 620" fill="none">
                                <rect x="342" y="34" width="32" height="26" rx="11"
                                      fill="var(--pp-ink-soft)" stroke="var(--pp-ink)" stroke-width="4" />
                                <path d="M357 62 C 375 94, 331 120, 353 164"
                                      stroke="var(--pp-ink)" stroke-width="13" stroke-linecap="round" />
                                <path d="M357 62 C 375 94, 331 120, 353 164"
                                      stroke="var(--pp-ink-soft)" stroke-width="7" stroke-linecap="round" />
                                <path d="M357 62 C 375 94, 331 120, 353 164"
                                      stroke="var(--pp-ink)" stroke-width="7" stroke-linecap="butt"
                                      stroke-dasharray="2 9" opacity="0.55" />
                            </svg>

                            <div class="bath__mat"></div>
                            <div class="bath__tub-back"></div>
                            <div class="bath__water-surface"></div>
                        </div>

                        <div class="bathroom__pet">
                            <PetAvatar Stage="_pet.Stage" Mood="_pet.Mood" Species="@_pet.Species" Name="@_pet.Name"
                                       Accessories="_pet.EquippedAccessories" ReactionClass="@_reaction" />
                        </div>

                        @* Vannanın ön kənarı və ördək pet-in önündədir — pet suyun
                           İÇİNDƏ dayanır. *@
                        <div class="bathroom__front" aria-hidden="true">
                            <div class="bath__tub-front"></div>
                            <div class="bath__duck">
                                <span class="bath__duck-body"></span>
                                <span class="bath__duck-head"></span>
                            </div>
                        </div>

                        @* Uşağın əlinə aldığı iki əşya SƏHNƏNİN ÖZÜNDƏDİR: sabun
                           qabında, duş divarda. Ayrıca "alət düyməsi" yoxdur —
                           uşaq ekranda gördüyü əşyaya toxunur və JS elə həmin
                           elementi klonlayıb barmağın arxasınca aparır
                           (data-drag-id). Beləliklə əldəki şəkil otaqdakı ilə
                           eynidir və uşaq nəyi tutduğunu axtarmır. *@
                        <div class="bathroom__props">
                            <div class="bath__soap-dish" aria-hidden="true"></div>

                            <button class="@SoapClass" data-drag-id="care-soap"
                                    disabled="@(_busy || _bathStep != BathStep.Soap)"
                                    @onpointerdown="StartBathToolAsync"
                                    aria-label="@Loc.T("Sabunu götür", "Pick up the soap")">
                                <span class="bath__soap-bar" aria-hidden="true"></span>
                            </button>

                            <button class="@ShowerClass" data-drag-id="care-shower"
                                    disabled="@(_busy || _bathStep != BathStep.Rinse)"
                                    @onpointerdown="StartBathToolAsync"
                                    aria-label="@Loc.T("Duşu götür", "Pick up the shower")">
                                @* Başlıq şlanqın ucuna oturur: -20° dönmə sapı
                                   yuxarı-sağa, su çıxan üzü isə aşağı-sola —
                                   pet-in üstünə — çevirir. *@
                                <svg class="bath__shower-art" viewBox="0 0 104 76" fill="none" aria-hidden="true">
                                    <g transform="rotate(-20 52 38)">
                                        <rect x="70" y="26" width="30" height="12" rx="6"
                                              fill="var(--pp-ink-soft)" stroke="var(--pp-ink)" stroke-width="4" />
                                        <ellipse cx="44" cy="49" rx="25" ry="9"
                                                 fill="#DCEBFF" stroke="var(--pp-ink)" stroke-width="4" />
                                        <rect x="14" y="18" width="60" height="30" rx="15"
                                              fill="var(--pp-primary)" stroke="var(--pp-ink)" stroke-width="4" />
                                        <rect x="21" y="23" width="46" height="9" rx="4.5"
                                              fill="var(--pp-primary-lift)" />
                                        <circle cx="33" cy="51" r="2.6" fill="var(--pp-ink-soft)" />
                                        <circle cx="44" cy="52" r="2.6" fill="var(--pp-ink-soft)" />
                                        <circle cx="55" cy="51" r="2.6" fill="var(--pp-ink-soft)" />
                                    </g>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <div class="bathroom__bar">
                        <button class="overlay-close" @onclick="() => SetModeAsync(CareMode.None)"
                                aria-label="@Loc.T("Hamamdan çıx", "Leave the bathroom")">✕</button>
                    </div>

                    @* Alt panelin işi yalnız DEMƏKDİR: nə etməli və nə qədər
                       qalıb. Alət burada deyil — o, otağın öz əşyasıdır. *@
                    <div class="bathroom__tools">
