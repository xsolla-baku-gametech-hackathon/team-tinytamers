                              <div class="bedroom__window-view">
                                <div class="bedroom__sun"></div>
                                <div class="bedroom__moon"></div>
                                <div class="bedroom__window-star"></div>
                                <div class="bedroom__window-star"></div>
                                <div class="bedroom__window-star"></div>
                                <div class="bedroom__window-star"></div>
                                <div class="bedroom__window-hill"></div>
