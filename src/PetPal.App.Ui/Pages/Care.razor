                            </div>

                            @* Divar əşyaları otağa tanış, sakit uşaq məkanı hissi verir. *@
                            <div class="bedroom__clock">
                              <div class="bedroom__clock-hand bedroom__clock-hand--hour"></div>
                              <div class="bedroom__clock-hand bedroom__clock-hand--minute"></div>
                            </div>
                            <div class="bedroom__picture">
                              <div class="bedroom__picture-art">
                                <div class="bedroom__picture-hill"></div>
                                <div class="bedroom__picture-paw"></div>
                              </div>
                            </div>

                            @* Döşəmə qatları dərinlik yaradır və son 16 faizi əşyasız saxlayır. *@
                            <div class="bedroom__floor">
                              <div class="bedroom__floor-planks"></div>
                            </div>
                            <div class="bedroom__skirting"></div>
                            <div class="bedroom__rug"></div>
                            <div class="bedroom__moonlight"></div>

                            @* YATAQ — SIFIRDAN, «My Talking Tom» istinadı ilə.
                               2026-09-06: əvvəlki altı versiya rədd edildi.

                               ORTAQ SƏHV BU İDİ: hər versiyada yataq çox sayda
                               hissədən yığılırdı — künc sütunları, dirəklər, yan tir,
                               ayaqlar, iki yastıq, ayaq başlığı. On beş forma bir-birinin
                               üstünə düşəndə göz onları tək əşya kimi birləşdirə bilmir.

                               Talking Tom-un yatağı isə CƏMİ DÖRD yumşaq formadır:
                               alçaq başlıq, qalın döşək, bir iri yastıq, bir örtük.
                               Dirək yoxdur, dolama yoxdur, tir yoxdur. Bu rəsm həmin
                               məntiqlə qurulub:

                               1. BAŞLIQ alçaq və enlidir — yalnız yumşaq bir qövs.
                                  Hündür başlıq yatağı şkafa, dirəklər isə beşiyə çevirirdi.
                               2. DÖŞƏK yatağın əsas kütləsidir və TƏK qapalı formadır:
                                  üst səth, ön üz və yumru künclər bir konturun içindədir.
                                  Əvvəl üç ayrı düzbucaqlı idi və lövhə kimi oxunurdu.
                               3. AYAQLAR kiçikdir — yatağı yerdən qaldırmaqdan başqa
                                  işi yoxdur; iri ayaq gözü yatağın kütləsindən yayındırır.
                               4. YASTIQ təkdir və pet-in ARXASINDADIR. İki yastıq
                                  pet-in yanlarında duranda siluet divana çevrilirdi.

                               ÖLÇÜ MƏHDUDİYYƏTİ: döşəyin üst səthi x 28..272, y 118..176
                               sahəsini doldurmalıdır — pet-in pəncələri oraya oturur,
                               yorğanın mövqeyi də ona bağlıdır. *@
                            <svg class="bedroom__bed" viewBox="0 0 300 268" fill="none" aria-hidden="true">
                                <ellipse cx="150" cy="246" rx="132" ry="14" fill="var(--bd-shadow-strong)" opacity="0.5" />

                                @* Baş və ayaq tərəfindəki başlıqlar — döşəyin arxasında. *@
                                <rect x="4" y="30" width="54" height="184" rx="22" fill="var(--bd-frame-lift)" stroke="var(--bd-frame-main)" stroke-width="5" />
                                <rect x="15" y="46" width="32" height="118" rx="15" fill="none" stroke="var(--bd-frame-main)" stroke-width="4" opacity="0.45" />
                                <rect x="250" y="106" width="40" height="108" rx="18" fill="var(--bd-frame-lift)" stroke="var(--bd-frame-main)" stroke-width="5" />
                                <rect x="260" y="120" width="20" height="58" rx="10" fill="none" stroke="var(--bd-frame-main)" stroke-width="4" opacity="0.45" />

                                @* Ayaqlar və çərçivə. *@
                                <rect x="42" y="214" width="24" height="30" rx="9" fill="var(--bd-frame-main)" />
                                <rect x="234" y="214" width="24" height="30" rx="9" fill="var(--bd-frame-main)" />
                                <rect x="22" y="186" width="256" height="42" rx="15" fill="var(--bd-frame-main)" />
                                <rect x="22" y="186" width="256" height="13" rx="6.5" fill="var(--bd-frame-lift)" opacity="0.6" />

                                @* Döşək: əvvəl ön üzü, üstündən üst səthi. *@
                                <rect x="28" y="150" width="244" height="44" rx="18" fill="var(--bd-sheet-shade)" stroke="var(--bd-sheet-edge)" stroke-width="4" />
                                <rect x="28" y="118" width="244" height="58" rx="22" fill="var(--bd-sheet)" stroke="var(--bd-sheet-edge)" stroke-width="4" />

                                @* Yastıq BAŞ tərəfdədir — pet-in oturduğu yerdən kənarda.
                                   Əvvəl pet-in altında qalır və ağ ləkə kimi oxunurdu. *@
                                <g transform="rotate(-6 78 142)">
                                    <rect x="36" y="114" width="84" height="52" rx="24" fill="#FFFFFF" stroke="var(--bd-sheet-edge)" stroke-width="4" />
                                    <path d="M54 130 C66 124 90 124 102 130" stroke="var(--bd-sheet-edge)" stroke-width="4" stroke-linecap="round" opacity="0.65" />
                                </g>
                            </svg>

                            @* Dolab lampanı yatağa yaxın və uşaq üçün aydın toxunma mövqeyində saxlayır. *@
                            <div class="bedroom__nightstand">
                              <div class="bedroom__nightstand-top"></div>
                              <div class="bedroom__nightstand-body">
                                <div class="bedroom__nightstand-drawer"></div>
                              </div>
                              <div class="bedroom__nightstand-leg"></div>
                              <div class="bedroom__nightstand-leg"></div>
                            </div>
                            <div class="bedroom__lamp">
                              <div class="bedroom__lamp-glow"></div>
                              <div class="bedroom__lamp-shade"></div>
                              <div class="bedroom__lamp-stem"></div>
                              <div class="bedroom__lamp-pull"></div>
                              <div class="bedroom__lamp-base"></div>
                            </div>

                            @* Kiçik döşəmə əşyaları pet qutusuna və aşağı idarə zolağına toxunmadan səhnəni tamamlayır. *@
                            <div class="bedroom__toy-chest">
                              <div class="bedroom__toy-chest-lid"></div>
                              <div class="bedroom__toy-chest-body"></div>
                              <div class="bedroom__toy-chest-lock"></div>
                            </div>
                            <div class="bedroom__slippers">
                              <div class="bedroom__slipper"></div>
                              <div class="bedroom__slipper"></div>
                            </div>

                            @* CSS yuxu fiqurları qaranlıq vəziyyətdə görünmək üçün əvvəlcədən eyni quruluşa daxildir. *@
                            <div class="bedroom__sleep-mark bedroom__sleep-mark--one"></div>
                            <div class="bedroom__sleep-mark bedroom__sleep-mark--two"></div>
                            <div class="bedroom__sleep-mark bedroom__sleep-mark--three"></div>
                        </div>

                        @* İşıq sönəndə əhval Sleepy olur: PetAvatar gözləri yumur
                           və "Zzz" özü çəkir. *@
                        <div class="bedroom__pet @(_inBed ? "bedroom__pet--in-bed" : null)">
                            <PetAvatar Stage="_pet.Stage" Mood="@(_lightsOff ? PetMood.Sleepy : _pet.Mood)"
                                       Species="@_pet.Species" Name="@_pet.Name"
                                       Accessories="_pet.EquippedAccessories" ReactionClass="@_reaction" />
                        </div>

                        @* Yorğan pet-in ÖNÜNDƏDİR — "yatağa girdi" hissini məhz bu
                           verir. Dekorun içində ola bilməz: dekor öz yığın
                           kontekstindədir (`isolation: isolate`), yəni oradakı heç
                           nə pet-in üstünə çıxa bilmir.

                           Element həmişə render olunur, amma pet yatağa çatana qədər
                           şəffafdır: pet hələ döşəmədə dayanarkən yorğan onun
                           belindən keçərdi. *@
                        <svg class="bedroom__quilt @(_inBed ? "bedroom__quilt--tucked" : null)"
                             viewBox="0 0 242 60" fill="none" aria-hidden="true">
                            <path d="M20 13 C80 2 162 2 222 13 C232 15 238 23 238 32 V38 C238 49 229 58 218 58 H24 C13 58 4 49 4 38 V32 C4 23 10 15 20 13 Z"
                                  fill="var(--bd-quilt)" stroke="var(--bd-quilt-edge)" stroke-width="5" stroke-linejoin="round" />

                            @* Qatlanmış mələfə: yorğanla döşəyin arasındakı ağ zolaq. *@
                            <path d="M20 13 C80 2 162 2 222 13 C229 14 234 19 235 26 C172 12 70 12 7 26 C8 19 13 14 20 13 Z"
                                  fill="var(--bd-sheet)" stroke="var(--bd-sheet-edge)" stroke-width="4" stroke-linejoin="round" />

                            <path d="M13 41 C76 31 166 31 229 41" stroke="var(--bd-quilt-lift)" stroke-width="5" stroke-linecap="round" opacity="0.75" />
                            <path d="M68 30 V54 M121 27 V54 M174 30 V54" stroke="var(--bd-quilt-edge)" stroke-width="4" stroke-linecap="round" opacity="0.35" />
                        </svg>


                        <button class="bedroom__lampbtn" disabled="@(_busy || _lightsOff || !_inBed)"
                                @onclick="ToggleLightsAsync"
                                aria-label="@(_lightsOff ? Loc.T("İşıq sönüb", "The light is off") : Loc.T("İşığı söndür", "Turn off the light"))"></button>
                    </div>

                    <div class="bedroom__bar">
                        <button class="overlay-close" @onclick="() => SetModeAsync(CareMode.None)"
                                aria-label="@Loc.T("Otaqdan çıx", "Leave the room")">✕</button>
                    </div>

                    <div class="bedroom__hint">@SleepHint</div>
                </div>
            }
        }
    }
</LoadingState>

@code {
    private enum CareMode { None, Feed, Bath, Sleep }

    /// <summary>Çimizdirmə iki addımlıdır: əvvəlcə sabunlamaq, sonra su ilə yaxalamaq.</summary>
    private enum BathStep { Soap, Rinse }

    private PetDto? _pet;
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string? _actionError;
    private string? _message;
    private string? _reaction;
    private List<PetAccessoryDto> _newAccessories = [];

    private CareMode _mode = CareMode.None;

    /// <summary>Paltar dəyişmə otağı açıqdır — tam ekran, qulluq rejimlərindən ayrı.</summary>
    private bool _closetOpen;

    /// <summary>Dizayn studiyasının vərəqi açıqdır — uşaq pet-ə geyindirmək istədiyini yazır.</summary>
    private bool _studioOpen;

    /// <summary>
    /// Geyindirilmiş dizaynın şəkli. Doludursa güzgü onu göstərir və pet dizayn
    /// paltarındadır; boşdursa otaq adi görünüşdədir.
    /// </summary>
    private string? _lookImage;

    private void ToggleStudio() => _studioOpen = !_studioOpen;

    private void CloseStudio() => _studioOpen = false;

    private void ShowLook(string? image) => _lookImage = image;

    /// <summary>Pet yatağa uzanıb — rejim açılan kimi, sürükləmə olmadan.</summary>
    private bool _inBed;

    /// <summary>Lampa söndürülüb: otaq qaralır və pet yatır.</summary>
    private bool _lightsOff;
    private BathStep _bathStep = BathStep.Soap;

    /// <summary>
    /// Alət uşağın əlindədir — otaqdakı əşya gizlənir, yoxsa sabun eyni anda
    /// həm qabda, həm barmağın altında görünür.
    /// </summary>
    private bool _toolHeld;
    private string _dragItem = string.Empty;
    private string _zone = "none";
    private int _latherPercent;
    private int _rinsePercent;

    private List<PetFoodDto> _foods = [];
    private PetFoodDto? _dragFood;

    /// <summary>Son porsiyadan sonra pet-in dediyi söz — yemək otağının sətrində qalır.</summary>
    private string? _feedMessage;

    private IJSObjectReference? _module;
    private DotNetObjectReference<Care>? _self;

    private int UnlockedCount => _pet?.Accessories.Count(a => a.IsUnlocked) ?? 0;

    private int EquippedCount => _pet?.Accessories.Count(a => a.IsEquipped) ?? 0;

    private string AccessoryMeta(PetAccessoryDto accessory) => accessory switch
    {
        { IsUnlocked: false } => accessory.Requirement,
        { IsEquipped: true } => Loc.T("Taxılıb", "Worn"),
        _ => Loc.T("Taxmaq üçün toxun", "Tap to wear")
    };

    /// <summary>
    /// Tam ekran otaqlardan biri açıqdır — səhnə və altındakı idarəetmə
    /// qatı çəkilmir.
    /// </summary>
    private bool IsRoomOpen => _closetOpen || _mode is CareMode.Feed or CareMode.Bath or CareMode.Sleep;

    private bool MouthOpen => _zone == "mouth" && _dragItem == "feed";


    private string? BubbleText => _message ?? _pet?.Message;

    /// <summary>Ən ucuz porsiya — dock düyməsindəki "⭐2+" nişanı.</summary>
    private int CheapestFoodCost => _foods.Count > 0 ? _foods.Min(f => f.StarCost) : 5;

    /// <summary>Pet toxdur — süfrə bağlanır (serverdəki hədd ilə eyni).</summary>
    private bool PetIsFull => Refuses(CareMode.Feed) is not null;

    /// <summary>
    /// Süfrənin üstündəki yeganə mətn sətri. Otaq yem veriləndən sonra da açıq
    /// qaldığına görə nəticə də buradan danışır — səhnədəki baloncuq otaqda
    /// görünmür. Sıra: xəta → əldəki yemin təsiri → pet-in cavabı → göstəriş.
    /// </summary>
    private string FeedHint
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(_actionError))
                return _actionError;

            if (_dragFood is not null)
                return $"{_dragFood.Name} · {_dragFood.Effect}";

            if (PetIsFull)
                return Refuses(CareMode.Feed)!;

            if (!string.IsNullOrWhiteSpace(_feedMessage))
                return _feedMessage;

            return State.Wallet.Stars < CheapestFoodCost
                ? Loc.T($"Ən ucuz yem {CheapestFoodCost} ulduzdur — bir tapşırıq həll edib qazan!", $"The cheapest snack costs {CheapestFoodCost} stars — solve a task to earn some!")
                : Loc.T($"Yemi {_pet?.Name}-ın ağzına apar", $"Bring the food to {_pet?.Name}'s mouth");
        }
    }

    private string SleepHint => !_inBed
        ? Loc.T($"{_pet?.Name} yatağa uzanır…", $"{_pet?.Name} is lying down…")
        : _lightsOff
            ? Loc.T($"{_pet?.Name} yuxuya getdi — sakit ol!", $"{_pet?.Name} fell asleep — stay quiet!")
            : Loc.T("Lampaya toxun və işığı söndür", "Tap the lamp and turn off the light");

    private string BathHint => _bathStep == BathStep.Soap
        ? Loc.T($"Sabunu götür və {_pet?.Name}-ın üstündə gəzdir", $"Grab the soap and rub it over {_pet?.Name}")
        : Loc.T($"Duşu götür və {_pet?.Name}-ın köpüyünü yu", $"Grab the shower and rinse {_pet?.Name}'s foam away");

    /// <summary>Zolaq addıma uyğun faizi göstərir: əvvəlcə köpük, sonra yaxalama.</summary>
    private int BathPercent => _bathStep == BathStep.Soap ? _latherPercent : _rinsePercent;

    /// <summary>JS-in gözlədiyi rejim açarları: köpük və yaxalama.</summary>
    private const string ToolSoap = "soap";
    private const string ToolWater = "water";

    private string BathTool => _bathStep == BathStep.Soap ? ToolSoap : ToolWater;

    private string BathToolDragId => _bathStep == BathStep.Soap ? "care-soap" : "care-shower";

    /// <summary>
    /// Otaqdakı əşyanın sinfi. Növbəsi çatan əşya yüngülcə "nəfəs alır" —
    /// uşaq mətni oxumadan da hansına toxunacağını görür; əldə tutulanda isə
    /// yerində qalmır (kölgəsi artıq barmağın altındadır).
    /// </summary>
    private string SoapClass => PropClass(BathStep.Soap, "bath__soap");

    private string ShowerClass => PropClass(BathStep.Rinse, "bath__shower");

    private string PropClass(BathStep step, string name)
    {
        var classes = $"bath__prop {name}";

        if (_bathStep != step)
            return classes;

        return _toolHeld ? $"{classes} bath__prop--held" : $"{classes} bath__prop--ready";
    }

    /// <summary>JS sürüklənən şəkli bu id ilə tapıb klonlayır.</summary>
    private static string FoodDragId(PetFoodDto food) => $"food-{food.Code}";

    private int HatchPercent => _pet is null || _pet.HatchStarCost <= 0
        ? 0
        : Math.Clamp(State.Wallet.Stars * 100 / _pet.HatchStarCost, 0, 100);

    private static string FillClass(int value) => value switch
    {
        >= 60 => "vitals__fill--good",
        >= 30 => "vitals__fill--warn",
        _ => "vitals__fill--low"
    };

    /// <summary>
    /// Ev ekranındakı qulluq kafelləri birbaşa rejim açır: <c>care?mode=bath</c>.
    /// Dəyərlər: <c>feed</c>, <c>bath</c>, <c>sleep</c>, <c>closet</c>.
    /// </summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "mode")]
    public string? ModeQuery { get; set; }

    private bool _modeQueryApplied;

    protected override Task OnInitializedAsync() => LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            _module = await Js.InvokeAsync<IJSObjectReference>("import", "./_content/PetPal.App.Ui/js/petCare.js");
            await _module.InvokeVoidAsync("init", _self);
        }

        // Otaqlar hər renderdən sonra ekrana oturdulur: rejim dəyişəndə,
        // pəncərə ölçüsü dəyişəndə və ilk açılışda eyni yol işləyir.
        if (_module is not null)
            await _module.InvokeVoidAsync("fitRooms");

        await TryApplyModeQueryAsync();
    }

    /// <summary>
    /// Sorğudakı rejimi bir dəfə tətbiq edir. İlk render pet yüklənməzdən əvvəl
    /// baş verə bilər, ona görə hər renderdən sonra yoxlanılır: şərt həm modulun,
    /// həm də pet-in hazır olmasıdır (rejim JS dinləyicilərinə bağlıdır).
    /// </summary>
    private async Task TryApplyModeQueryAsync()
    {
        if (_modeQueryApplied || _module is null || _pet is null)
            return;

        _modeQueryApplied = true;

        // Yumurta rejimində qulluq səhnələri yoxdur — orada tək bir iş var.
        if (!_pet.IsHatched || string.IsNullOrWhiteSpace(ModeQuery))
            return;

        switch (ModeQuery.ToLowerInvariant())
        {
            case "feed":
                await SetModeAsync(CareMode.Feed);
                break;
            case "bath":
                await SetModeAsync(CareMode.Bath);
                break;
            case "sleep":
                await SetModeAsync(CareMode.Sleep);
                break;
            case "closet":
                // Şkaf tam ekran otaqdır — rejim deyil, üstdən açılan səhnə.
                await OpenClosetAsync();
                break;
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        var result = await Api.GetPetAsync();

        _loading = false;

        if (!result.Succeeded || result.Value is null)
        {
            _error = result.Error;
            return;
        }

        _pet = result.Value;
        State.ApplyPet(_pet);

        var wallet = await Api.GetWalletAsync();
        if (wallet.Succeeded && wallet.Value is not null)
            State.ApplyWallet(wallet.Value);

        // Yemək kataloqu statikdir — bir dəfə yüklənir və ekran boyu qalır.
        if (_foods.Count == 0)
        {
            var foods = await Api.GetPetFoodsAsync();
            if (foods.Succeeded && foods.Value is not null)
                _foods = foods.Value;
        }
    }

    private void GoToGames() => Navigation.NavigateTo("play");

    /// <summary>
    /// Şkaf rejim deyil, tam ekran otaqdır. Açılmazdan əvvəl işləyən qulluq
    /// rejimi bağlanır: yoxsa arxada qalan JS dinləyiciləri (sabun, yataq)
    /// otağın içindəki toxunuşları da tutardı.
    /// </summary>
    /// <summary>
    /// Yuxu artıq sürükləmə deyil: rejim açılan kimi pet yatağa uzanır, uşağın
    /// tək işi lampanı söndürməkdir. Səbəb uşağın öz təcrübəsidir — yatmaq
    /// yatağa daşınmaq deyil, işığın sönməsidir.
    /// </summary>
    private async Task LiePetDownAsync()
    {
        _inBed = false;
        _lightsOff = false;
        StateHasChanged();

        // Bir kadr gözləyirik ki, CSS keçidi başlanğıc vəziyyətdən işləsin:
        // eyni renderdə qoyulan sinif animasiyasız "tullanma" verir.
        await Task.Delay(80);

        _inBed = true;
        StateHasChanged();
    }

    /// <summary>
    /// Lampa bir dəfə işləyir: söndü, otaq qaraldı, pet yatdı. Sorğu
    /// animasiyadan SONRA gedir ki, uşaq nəticəni səhnədə görsün, sonra
    /// mesajda oxusun.
    /// </summary>
    /// <summary>
    /// Növü dəyişir. Server yalnız görünüşü yeniləyir və tam pet-i qaytarır,
    /// ona görə ekran öz təxminini deyil, serverin dediyini göstərir.
    /// </summary>
    private async Task ChangeSpeciesAsync(string species)
    {
        if (_busy || _pet is null || _pet.Species == species)
            return;

        _busy = true;
        _actionError = null;
        StateHasChanged();

        var result = await Api.ChangeSpeciesAsync(species);

        _busy = false;

        if (!result.Succeeded || result.Value is null)
        {
            _actionError = result.Error;
            StateHasChanged();
            return;
        }

        _pet = result.Value;
        State.ApplyPet(_pet);
        StateHasChanged();
    }

    private async Task ToggleLightsAsync()
    {
        if (_busy || _lightsOff || !_inBed)
            return;

        _lightsOff = true;
        StateHasChanged();

        await Task.Delay(900);
        await RunCareAsync(CareAction.Sleep, "sleep");

        await Task.Delay(1600);

        if (_mode == CareMode.Sleep)
            await SetModeAsync(CareMode.None);
    }

    private async Task OpenClosetAsync()
    {
        await SetModeAsync(CareMode.None);
        _actionError = null;
        _closetOpen = true;
    }

    private void CloseCloset()
    {
        _closetOpen = false;
        _actionError = null;
    }

    /// <summary>Rejim dəyişəndə köhnə rejimin JS dinləyiciləri mütləq söndürülür.</summary>
    private async Task SetModeAsync(CareMode mode)
    {
        var next = _mode == mode ? CareMode.None : mode;

        await StopCurrentModeAsync();

        _mode = CareMode.None;
        _actionError = null;
        _feedMessage = null;
        _latherPercent = 0;
        _rinsePercent = 0;
        _bathStep = BathStep.Soap;
        _toolHeld = false;
        _dragFood = null;
        _inBed = false;
        _lightsOff = false;

        // Mükafat banneri yalnız YENİ otaq açılanda silinir: otaqda açılan əşya
        // uşaq özü çıxandan sonra ekranda görünməlidir.
        if (next != CareMode.None)
            _newAccessories = [];

        // Pet onsuz da tox/təmizdirsə səhnə açılmır: uşaq bütün işi görüb sonda
        // serverdən "lazım deyil" cavabı almamalıdır.
        if (Refuses(next) is { } refusal)
        {
            _actionError = refusal;
            StateHasChanged();
            return;
        }

        _mode = next;

        // Səhnə rejim sinfini alsın deyə əvvəlcə render edirik, sonra JS bağlanır.
        StateHasChanged();
        await Task.Yield();

        if (_module is null)
            return;

        switch (_mode)
        {
            case CareMode.Bath:
                await _module.InvokeVoidAsync("startBath");
                break;
            case CareMode.Sleep:
                await LiePetDownAsync();
                break;
        }
    }

    /// <summary>
    /// Serverin qulluq şərtləri ilə eyni hədlər (<c>PetService.CareAsync</c>) —
    /// fərq yalnız odur ki, imtina işin əvvəlində, sonunda deyil.
    /// </summary>
    private string? Refuses(CareMode mode) => (mode, _pet) switch
    {
        (CareMode.Feed, { Fullness: >= 95 } pet) => Loc.T($"{pet.Name} indi toxdur.", $"{pet.Name} is full right now."),
        (CareMode.Bath, { Cleanliness: >= 95 } pet) => Loc.T($"{pet.Name} onsuz da tərtəmizdir.", $"{pet.Name} is already spotless."),
        (CareMode.Sleep, { Energy: >= 95 } pet) => Loc.T($"{pet.Name} tamamilə oyaqdır.", $"{pet.Name} is wide awake."),
        _ => null
    };

    private async Task StopCurrentModeAsync()
    {
        if (_module is null)
            return;

        switch (_mode)
        {
            case CareMode.Bath:
                await _module.InvokeVoidAsync("stopBath");
                break;
        }
    }

    private async Task StartFoodDragAsync(PetFoodDto food, PointerEventArgs e)
    {
        if (_busy || _module is null || PetIsFull || State.Wallet.Stars < food.StarCost)
            return;

        _feedMessage = null;

        _dragFood = food;
        await StartItemDragAsync("feed", food.Icon, FoodDragId(food), e);
    }

    /// <summary>
    /// Sabun və su sürüklənib buraxılan əşya deyil — barmağın arxasınca gedir və
    /// pet-in üstündən keçdiyi yerə təsir edir, ona görə ayrıca JS rejimi var.
    /// </summary>
    private async Task StartBathToolAsync(PointerEventArgs e)
    {
        if (_busy || _module is null)
            return;

        _actionError = null;
        _toolHeld = true;

        await _module.InvokeVoidAsync(
            "startBathTool", BathTool, BathToolDragId, e.PointerId, e.ClientX, e.ClientY);
    }

    /// <summary>Barmaq qalxdı (və ya addım bitdi) — əşya öz yerinə qayıdır.</summary>
    [JSInvokable]
    public Task OnBathToolReleased()
    {
        _toolHeld = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task StartItemDragAsync(string key, string icon, string visualId, PointerEventArgs e)
    {
        if (_busy || _module is null)
            return;

        _actionError = null;
        _dragItem = key;

        await _module.InvokeVoidAsync("startDrag", key, icon, visualId, e.PointerId, e.ClientX, e.ClientY);
    }

    [JSInvokable]
    public Task OnZoneChange(string zone)
    {
        _zone = zone;
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnLatherProgress(int percent)
    {
        _latherPercent = percent;

        // Bütün bədən sabunlandı — panel özü suya keçir, düymə lazım deyil.
        if (percent >= 100)
            _bathStep = BathStep.Rinse;

        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnRinseProgress(int percent)
    {
        _rinsePercent = percent;
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public async Task OnRinsed()
    {
        await RunCareAsync(CareAction.Clean, "clean");
        await SetModeAsync(CareMode.None);
    }

    [JSInvokable]
    public async Task OnDrop(string itemKey, string zone)
    {
        var food = _dragFood;

        _dragItem = string.Empty;
        _dragFood = null;
        _zone = "none";


        if (zone == "none")
        {
            StateHasChanged();
            return;
        }

        if (itemKey == "feed" && zone != "mouth")
        {
            _actionError = Loc.T($"Yemi {_pet?.Name}-ın ağzına apar.", $"Bring the food to {_pet?.Name}'s mouth.");
            StateHasChanged();
            return;
        }

        await RunCareAsync(CareAction.Feed, "feed", food?.Code);

        // Otaq ÖZÜ bağlanmır: uşaq nə qədər istəyirsə yedizdirir və ✕ ilə özü
        // çıxır. Əvvəl otaq burada bağlanırdı — uşaq yemi ağıza aparan kimi
        // eşiyə atılırdı, pet-in cavabını görmürdü və ikinci porsiya üçün otağı
        // yenidən açmalı olurdu.
        _feedMessage = _actionError is null ? _message : null;
        StateHasChanged();
    }

    private async Task RunCareAsync(CareAction action, string reactionKey, string? food = null)
    {
        _busy = true;
        _actionError = null;
        _reaction = $"pet--{reactionKey}";
        StateHasChanged();

        var result = await Api.CareAsync(action, food);

        _busy = false;

        if (!result.Succeeded || result.Value is null)
        {
            _reaction = null;
            _actionError = result.Error;
            StateHasChanged();
            return;
        }

        _pet = result.Value.Pet;
        _message = result.Value.Message;
        _newAccessories = result.Value.NewAccessories;
        State.ApplyPet(_pet);

        if (result.Value.StarsSpent > 0)
        {
            var wallet = await Api.GetWalletAsync();
            if (wallet.Succeeded && wallet.Value is not null)
                State.ApplyWallet(wallet.Value);
        }

        StateHasChanged();

        await Task.Delay(700);
        _reaction = null;
        StateHasChanged();
    }

    private Task ToggleAccessoryAsync(PetAccessoryDto accessory)
    {
        if (_pet is null || !accessory.IsUnlocked)
            return Task.CompletedTask;

        var codes = _pet.EquippedAccessories.ToList();

        if (!codes.Remove(accessory.Code))
            codes.Add(accessory.Code);

        return SaveLookAsync(codes);
    }

    private Task ClearAccessoriesAsync() => SaveLookAsync([]);

    /// <summary>
    /// Görünüş serverdə saxlanılır ki, telefon dəyişəndə də qalsın. Cavab tam
    /// pet-i qaytarır — ekran serverin dediyi vəziyyəti göstərir, öz təxminini yox.
    /// </summary>
    private async Task SaveLookAsync(List<string> codes)
    {
        _busy = true;
        _actionError = null;
        StateHasChanged();

        var result = await Api.EquipAccessoriesAsync(codes);

        _busy = false;

        if (!result.Succeeded || result.Value is null)
        {
            _actionError = result.Error;
            StateHasChanged();
            return;
        }

        _pet = result.Value;
        State.ApplyPet(_pet);
        StateHasChanged();
    }

    private async Task HatchAsync()
    {
        _busy = true;
        _actionError = null;

        var result = await Api.HatchPetAsync();

        _busy = false;

        if (!result.Succeeded || result.Value is null)
        {
            _actionError = result.Error;
            return;
        }

        _pet = result.Value.Pet;
        _message = result.Value.Message;
        _reaction = "pet--hatch";
        State.ApplyPet(_pet);

        var wallet = await Api.GetWalletAsync();
        if (wallet.Succeeded && wallet.Value is not null)
            State.ApplyWallet(wallet.Value);

        StateHasChanged();
        await Task.Delay(900);
        _reaction = null;
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Səhifə bağlanarkən körpü artıq qapanmış ola bilər.
            }
        }

        _self?.Dispose();
    }
}
