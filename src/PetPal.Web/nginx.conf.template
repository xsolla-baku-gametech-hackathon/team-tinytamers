# Blazor WebAssembly statik host-u. nginx-unprivileged üzərində işləyir (proses root deyil).
#
# Bu fayl ŞABLONDUR: nginx-in öz entrypoint-i start zamanı ${PORT}-u environment
# variable-dan doldurur — Railway kimi platformalar portu özləri diktə edir.

server {
    listen       ${PORT};
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    # Böyük .wasm/.dat faylları hazır sıxılmış (.gz) variantı ilə verilir —
    # publish zamanı CompressionEnabled onları yaradır.
    gzip_static  on;
    gzip         on;
    gzip_types   text/css application/javascript application/json application/wasm image/svg+xml;
    gzip_min_length 1024;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Container Apps probe-ları (V7 ilə eyni müqavilə: live = proses, ready = xidmət hazırdır).
    location = /health/live {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    location = /health/ready {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # ---------- Cache qaydası ----------
    # Uzun cache YALNIZ adı məzmunla birlikdə dəyişən fayla verilir
    # (dotnet.native.<hash>.wasm, PetPal.App.Ui.<hash>.wasm). Belə faylda məzmun
    # dəyişəndə ÜNVAN da dəyişir, yəni brauzer köhnəni heç vaxt qaytara bilmir.
    #
    # Adı sabit qalan fayllar aşağıdakı regex blokları ilə tutulur. nginx-də
    # regex location prefix location-dan üstündür, ona görə onlar bu qaydalardan
    # əvvəl yoxlanılır.

    # Blazor-un giriş faylları — adında hash YOXDUR, məzmunu isə hər deploy-da
    # dəyişir. immutable ilə verilsəydi (əvvəl belə idi), saytı bir dəfə açmış
    # cihaz bir il köhnə yükləyicidə qalar, o isə artıq mövcud olmayan hash-lı
    # .wasm adlarını çağırardı — app "açılır…" ekranında ilişib qalardı.
    #
    # no-cache "saxlama" demək deyil: fayl saxlanılır, sadəcə hər dəfə soruşulur
    # və dəyişməyibsə 304 (~150 bayt) qayıdır. Çəkili hissə — meqabaytlarla .wasm —
    # hash daşıdığı üçün onsuz da bir il cache-də qalır.
    location ~ ^/_framework/(blazor\.webassembly\.js|dotnet\.js)$ {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Dizayn və JS: app.css, theme.css, pet.css, petCare.js — adları sabitdir.
    # 7 günlük cache ilə dizayn dəyişikliyi mövcud istifadəçilərə bir həftəyə
    # qədər çatmırdı: yeni HTML köhnə CSS ilə görünürdü.
    location ~ ^/_content/.+\.(css|js)$ {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Qalan framework faylları hash ilə adlanır — uzun cache təhlükəsizdir.
    location /_framework/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Şəkil, şrift və s. — dizayn faylları yuxarıdakı regex ilə tutulur.
    location /_content/ {
        add_header Cache-Control "public, max-age=604800";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Web host-un öz JS faylları (js/photoPicker.js) — bunların da adı sabitdir.
    location ~ ^/js/.+\.js$ {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Bunlar deploy-dan deploy-a dəyişir (API ünvanı, boot manifesti) — cache olunmamalıdır.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location = /appsettings.json {
        # Bu fayl start zamanı yenidən yazılır (bax nginx-init-api-base-url.sh).
        # gzip_static burada BAĞLI olmalıdır: açıq qalsa nginx publish-dən gələn
        # köhnə .gz nüsxəsini verər və app səhv API ünvanına baxar.
        gzip_static off;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # SPA marşrutlaşdırması: /care, /play və s. birbaşa açılanda index.html qaytarılır.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
