<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PetPal.App"
             xmlns:ui="clr-namespace:PetPal.App.Ui;assembly=PetPal.App.Ui"
             x:Class="PetPal.App.MainPage"
             BackgroundColor="#F5F2FF">

    <!-- Bütün ekranlar PetPal.App.Ui kitabxanasındadır; host yalnız WebView-i qurur. -->
    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type ui:Routes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
